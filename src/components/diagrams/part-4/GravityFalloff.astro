---
// Earth's gravitational field strength g = GM/r² = 9.82 (R/r)² m/s², from the surface out to 8 Earth radii.
// Marks: the surface, the ISS (400 km up), half strength (r = √2 R) and the geostationary radius (6.62 R).
const g0 = 9.82;
const L = 80, R = 570, T = 30, B = 250, xMax = 8;
const px = (x: number) => L + ((x - 0) / xMax) * (R - L);
const py = (g: number) => B - (g / 10) * (B - T);
const curve = Array.from({ length: 141 }, (_, i) => {
	const x = 1 + ((xMax - 1) * i) / 140;
	return `${i ? 'L' : 'M'}${px(x).toFixed(1)},${py(g0 / x ** 2).toFixed(1)}`;
}).join(' ');
const marks = [
	{ x: 1, label: 'surface: 9.82 m/s²', dx: 12, dy: -2 },
	{ x: 6771 / 6371, label: 'ISS, 400 km up: 8.69 m/s²', dx: 14, dy: 18 },
	{ x: Math.SQRT2, label: 'half strength at r = √2 R', dx: 12, dy: 4 },
	{ x: 42164 / 6371, label: 'geostationary: 0.224 m/s²', dx: -6, dy: -16, end: true },
];
---

<svg class="dg" viewBox="0 0 600 320" xmlns="http://www.w3.org/2000/svg">
	<rect x={px(0)} y={T} width={px(1) - px(0)} height={B - T} class="f-sky-soft" />
	<text x={(px(0) + px(1)) / 2} y={B - 10} class="t-mid t-sm f-sky">Earth</text>
	{[0, 2, 4, 6, 8, 10].map((g) => (
		<>
			<line x1={L} y1={py(g)} x2={R} y2={py(g)} class="s-grid w1" />
			<text x={L - 8} y={py(g) + 4} class="t-end t-sm f-muted">{g}</text>
		</>
	))}
	{[0, 1, 2, 3, 4, 5, 6, 7, 8].map((x) => <text x={px(x)} y={B + 18} class="t-mid t-sm f-muted">{x}</text>)}
	<line x1={L} y1={B} x2={R} y2={B} class="s-fg w2" />
	<line x1={L} y1={B} x2={L} y2={T} class="s-fg w2" />
	<path d={curve} class="s-rose w3" fill="none" />
	{marks.map((m) => (
		<>
			<circle cx={px(m.x)} cy={py(g0 / m.x ** 2)} r="5" class="f-amber" />
			<text x={px(m.x) + m.dx} y={py(g0 / m.x ** 2) + m.dy} class={`t-sm halo ${m.end ? 't-end' : ''}`}>{m.label}</text>
		</>
	))}
	<text x={(L + R) / 2} y={B + 40} class="t-mid t-sm">distance from Earth’s centre, in Earth radii (r / R)</text>
	<text x="24" y={(T + B) / 2} class="t-mid t-sm" transform={`rotate(-90 24 ${(T + B) / 2})`}>g (m/s²)</text>
	<text x={R} y={T + 16} class="t-end t-sm f-rose">g = 9.82 (R / r)²</text>
</svg>
