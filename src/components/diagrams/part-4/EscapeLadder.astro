---
// Escape speeds compared (km/s). Surface values from NASA fact sheets (Adrian: our model). The last two bars are
// escape from a star, starting at a planet's orbit, with the planet's own orbital speed marked inside the bar.
const rows = [
	{ n: 'Moon (surface)', v: 2.38 },
	{ n: 'Mars (surface)', v: 5.03 },
	{ n: 'Venus (surface)', v: 10.36 },
	{ n: 'Earth (surface)', v: 11.19 },
	{ n: 'Adrian, our model (surface)', v: 18.1 },
	{ n: 'Sun, from Earth’s orbit', v: 42.1, orb: 29.78 },
	{ n: 'Tau Ceti, from Adrian’s orbit', v: 50.7, orb: 35.9 },
];
const L = 215, R = 560, T = 20, H = 34, vMax = 55;
const px = (v: number) => L + (v / vMax) * (R - L);
---

<svg class="dg" viewBox="0 0 600 350" xmlns="http://www.w3.org/2000/svg">
	{[0, 10, 20, 30, 40, 50].map((v) => (
		<>
			<line x1={px(v)} y1={T} x2={px(v)} y2={T + rows.length * H} class="s-grid w1" />
			<text x={px(v)} y={T + rows.length * H + 18} class="t-mid t-sm f-muted">{v}</text>
		</>
	))}
	{rows.map((r, i) => (
		<>
			<text x={L - 8} y={T + i * H + H / 2 + 4} class="t-end t-sm">{r.n}</text>
			<rect x={L} y={T + i * H + 7} width={px(r.v) - L} height={H - 14} class={r.orb ? 'f-amber-soft s-amber w1' : 'f-sky-soft s-sky w1'} />
			{r.orb && <rect x={L} y={T + i * H + 7} width={px(r.orb) - L} height={H - 14} class="f-green-soft s-green w1" />}
			<text x={px(r.v) + 6} y={T + i * H + H / 2 + 4} class="t-sm t-b">{r.v}</text>
		</>
	))}
	<text x={(L + R) / 2} y={T + rows.length * H + 40} class="t-mid t-sm">escape speed (km/s)</text>
	<text x={(L + R) / 2} y={T + rows.length * H + 62} class="t-mid t-sm f-green">green: the planet’s own orbital speed, a head start</text>
</svg>
