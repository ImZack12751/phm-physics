---
// Kepler's third law on log–log axes: orbital period T (years) against semi-major axis a (au) for the eight planets
// (NASA planetary fact sheet). The points lie on a straight line of gradient 3/2, i.e. T² = a³.
const AU = 149.6;
const planets = [
	{ n: 'Mercury', d: 57.9, t: 88.0 },
	{ n: 'Venus', d: 108.2, t: 224.7 },
	{ n: 'Earth', d: 149.6, t: 365.2 },
	{ n: 'Mars', d: 228.0, t: 687.0 },
	{ n: 'Jupiter', d: 778.5, t: 4331 },
	{ n: 'Saturn', d: 1432.0, t: 10747 },
	{ n: 'Uranus', d: 2867.0, t: 30589 },
	{ n: 'Neptune', d: 4515.0, t: 59800 },
].map((p) => ({ ...p, a: p.d / AU, T: p.t / 365.25 }));
const L = 80, R = 560, T0 = 20, B = 260;
const xMin = -0.6, xMax = 1.6, yMin = -0.8, yMax = 2.4; // log10 ranges
const px = (a: number) => L + ((Math.log10(a) - xMin) / (xMax - xMin)) * (R - L);
const py = (t: number) => B - ((Math.log10(t) - yMin) / (yMax - yMin)) * (B - T0);
const line = `M${px(10 ** xMin)},${py(10 ** (1.5 * xMin))} L${px(10 ** xMax)},${py(10 ** (1.5 * xMax))}`;
const left = new Set(['Venus', 'Mars', 'Saturn', 'Neptune']);
---

<svg class="dg" viewBox="0 0 600 320" xmlns="http://www.w3.org/2000/svg">
	{[0.1, 1, 10, 100].map((t) => (
		<>
			<line x1={L} y1={py(t)} x2={R} y2={py(t)} class="s-grid w1" />
			<text x={L - 8} y={py(t) + 4} class="t-end t-sm f-muted">{t}</text>
		</>
	))}
	{[0.3, 1, 3, 10, 30].map((a) => (
		<>
			<line x1={px(a)} y1={T0} x2={px(a)} y2={B} class="s-grid w1" />
			<text x={px(a)} y={B + 18} class="t-mid t-sm f-muted">{a}</text>
		</>
	))}
	<line x1={L} y1={B} x2={R} y2={B} class="s-fg w2" />
	<line x1={L} y1={B} x2={L} y2={T0} class="s-fg w2" />
	<path d={line} class="s-rose w2 dash" fill="none" />
	{planets.map((p) => (
		<>
			<circle cx={px(p.a)} cy={py(p.T)} r="5" class="f-amber" />
			<text x={px(p.a) + (left.has(p.n) ? -10 : 10)} y={py(p.T) + (left.has(p.n) ? -6 : p.n === 'Mercury' ? -8 : 14)} class={`t-sm halo ${left.has(p.n) ? 't-end' : ''}`}>{p.n}</text>
		</>
	))}
	<text x={(L + R) / 2} y={B + 40} class="t-mid t-sm">semi-major axis a (au), logarithmic scale</text>
	<text x="24" y={(T0 + B) / 2} class="t-mid t-sm" transform={`rotate(-90 24 ${(T0 + B) / 2})`}>period T (years), log scale</text>
	<text x={L + 12} y={T0 + 16} class="t-sm f-rose">gradient 3/2: T² = a³</text>
</svg>
