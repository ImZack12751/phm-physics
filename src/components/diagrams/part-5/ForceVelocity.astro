---
// Power P = Fv: in a short time Δt, a force F moves its object a distance vΔt, doing work F·vΔt; per second, Fv.
const Y = 150, x0 = 110, dx = 250, bw = 80, bh = 56;
---

<svg class="dg" viewBox="0 0 600 270" xmlns="http://www.w3.org/2000/svg">
	<line x1="40" y1={Y + bh / 2} x2="560" y2={Y + bh / 2} class="s-fg w2" />
	<rect x={x0} y={Y - bh / 2} width={bw} height={bh} class="f-sky-soft s-sky w2 dash" />
	<text x={x0 + bw / 2} y={Y + 5} class="t-mid t-sm f-muted">at time t</text>
	<rect x={x0 + dx} y={Y - bh / 2} width={bw} height={bh} class="f-sky-soft s-sky w2" />
	<text x={x0 + dx + bw / 2} y={Y + 5} class="t-mid t-sm">at t + Δt</text>
	<!-- force arrow pushing from behind -->
	<line x1={x0 + dx - 70} y1={Y} x2={x0 + dx - 12} y2={Y} class="s-rose w3" />
	<polygon points={`${x0 + dx},${Y} ${x0 + dx - 13},${Y - 7} ${x0 + dx - 13},${Y + 7}`} class="f-rose" />
	<text x={x0 + dx - 44} y={Y - 12} class="t-mid t-sm f-rose t-b">F</text>
	<!-- velocity -->
	<line x1={x0 + dx + bw + 8} y1={Y - 40} x2={x0 + dx + bw + 70} y2={Y - 40} class="s-green w2" />
	<polygon points={`${x0 + dx + bw + 82},${Y - 40} ${x0 + dx + bw + 70},${Y - 46} ${x0 + dx + bw + 70},${Y - 34}`} class="f-green" />
	<text x={x0 + dx + bw + 45} y={Y - 50} class="t-mid t-sm f-green">speed v</text>
	<!-- distance moved -->
	<line x1={x0} y1={Y + bh / 2 + 30} x2={x0 + dx} y2={Y + bh / 2 + 30} class="s-amber w2" />
	<line x1={x0} y1={Y + bh / 2 + 22} x2={x0} y2={Y + bh / 2 + 38} class="s-amber w2" />
	<line x1={x0 + dx} y1={Y + bh / 2 + 22} x2={x0 + dx} y2={Y + bh / 2 + 38} class="s-amber w2" />
	<text x={x0 + dx / 2} y={Y + bh / 2 + 54} class="t-mid t-sm f-amber">distance moved = v Δt</text>
	<text x="300" y="34" class="t-mid t-b">work in Δt = F × vΔt &nbsp;⇒&nbsp; power P = Fv</text>
	<text x="300" y="56" class="t-mid t-sm">the same force delivers more power the faster its object moves</text>
</svg>
