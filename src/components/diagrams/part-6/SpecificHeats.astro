---
// Specific heats, J/(kg K), from OpenStax University Physics Vol. 2, Table 1.3 (steam and air at constant pressure).
const rows = [
	{ n: 'liquid water', c: 4186, cls: 'f-sky' },
	{ n: 'ice', c: 2090, cls: 'f-sky' },
	{ n: 'steam', c: 2020, cls: 'f-sky' },
	{ n: 'air', c: 1015, cls: 'f-violet' },
	{ n: 'aluminium', c: 900, cls: 'f-amber' },
	{ n: 'glass', c: 840, cls: 'f-green' },
	{ n: 'iron and steel', c: 452, cls: 'f-amber' },
	{ n: 'copper', c: 387, cls: 'f-amber' },
];
const L = 150, R = 520, T = 20, H = 30, cMax = 4500;
const w = (c: number) => (c / cMax) * (R - L);
---

<svg class="dg" viewBox="0 0 600 300" xmlns="http://www.w3.org/2000/svg">
	{rows.map((r, i) => (
		<>
			<text x={L - 10} y={T + i * H + 19} class="t-end t-sm">{r.n}</text>
			<rect x={L} y={T + i * H + 5} width={w(r.c)} height={H - 10} class={r.cls} />
			<text x={L + w(r.c) + 8} y={T + i * H + 19} class="t-sm f-muted">{r.c.toLocaleString('en-GB')}</text>
		</>
	))}
	<line x1={L} y1={T} x2={L} y2={T + rows.length * H} class="s-fg w2" />
	<text x={(L + R) / 2} y={T + rows.length * H + 32} class="t-mid t-sm">heat to warm 1 kg by 1 K, J/(kg·K)</text>
</svg>
