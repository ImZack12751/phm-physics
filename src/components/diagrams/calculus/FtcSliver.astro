---
// The area-so-far A(x) grows by a thin sliver f(x)·h when x moves to x + h, so A′(x) = f(x).
const O = { x: 60, y: 250 }, W = 330, H = 200;
const f = (u: number) => 0.3 + 0.9 * u - 0.55 * u * u; // u in [0, 1]
const px = (u: number) => O.x + u * W, py = (v: number) => O.y - v * H;
const a = 0.08, x = 0.58, h = 0.09;
const pathBetween = (u0: number, u1: number) =>
	`M${px(u0)},${py(0)} ` +
	Array.from({ length: 31 }, (_, i) => {
		const u = u0 + ((u1 - u0) * i) / 30;
		return `L${px(u).toFixed(1)},${py(f(u)).toFixed(1)}`;
	}).join(' ') +
	` L${px(u1)},${py(0)} Z`;
const curve = Array.from({ length: 61 }, (_, i) => `${i ? 'L' : 'M'}${px(i / 60).toFixed(1)},${py(f(i / 60)).toFixed(1)}`).join(' ');
---

<svg class="dg" viewBox="0 0 600 310" xmlns="http://www.w3.org/2000/svg">
	<path d={pathBetween(a, x)} class="f-amber-soft" />
	<path d={pathBetween(x, x + h)} class="f-sky-soft s-sky w1" />
	<path d={curve} class="s-amber w3" />
	<line x1={O.x} y1={O.y} x2={O.x + W + 10} y2={O.y} class="s-fg w2" />
	<line x1={O.x} y1={O.y} x2={O.x} y2={O.y - H - 10} class="s-fg w2" />
	<line x1={px(x)} y1={py(0)} x2={px(x)} y2={py(f(x))} class="s-sky w2" />
	<text x={px(a)} y={O.y + 18} class="t-mid t-it">a</text>
	<text x={px(x)} y={O.y + 18} class="t-mid t-it">x</text>
	<text x={px(x + h) + 4} y={O.y + 18} class="t-it">x + h</text>
	<text x={(px(a) + px(x)) / 2} y={py(0.22)} class="t-mid t-b f-amber halo">A(x)</text>
	<text x={(px(a) + px(x)) / 2} y={py(0.22) + 18} class="t-mid t-sm f-amber halo">area so far</text>
	<text x={px(x) - 6} y={py(f(x) / 2)} class="t-end t-sm f-sky halo">height f(x)</text>
	<text x={px(x + h / 2)} y={O.y + 38} class="t-mid t-sm f-sky">width h</text>
	<text x={px(0.97)} y={py(0.74)} class="t-end t-sm f-amber">y = f(t)</text>

	<text x="420" y="70" class="t-sm f-sky">new sliver ≈ rectangle:</text>
	<text x="420" y="92" class="t-b">A(x + h) − A(x) ≈ f(x) · h</text>
	<text x="420" y="130" class="t-sm f-muted">divide by h:</text>
	<text x="420" y="152" class="t-b">[A(x + h) − A(x)] / h ≈ f(x)</text>
	<text x="420" y="190" class="t-sm f-muted">let h → 0:</text>
	<text x="420" y="214" class="t-b f-green">A′(x) = f(x)</text>
	<text x="420" y="240" class="t-sm f-muted">The area grows at a rate</text>
	<text x="420" y="256" class="t-sm f-muted">equal to the curve’s height.</text>
</svg>
