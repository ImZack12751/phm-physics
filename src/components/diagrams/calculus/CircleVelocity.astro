---
// Why the slope of sin is cos: a point on the unit circle turning by a tiny angle dθ moves a distance dθ
// at right angles to the radius. That small step has a vertical part cos θ·dθ and a horizontal part −sin θ·dθ.
const O = { x: 150, y: 175 }, R = 120;
const th = (50 * Math.PI) / 180;
const P = { x: O.x + R * Math.cos(th), y: O.y - R * Math.sin(th) };
const L = 95; // drawn length of the (magnified) step
const step = { x: -L * Math.sin(th), y: -L * Math.cos(th) }; // screen y is down
const Q = { x: P.x + step.x, y: P.y + step.y };
---

<svg class="dg" viewBox="0 0 620 320" xmlns="http://www.w3.org/2000/svg">
	<defs>
		{['fg', 'amber', 'sky'].map((c) => (
			<marker id={`cv-${c}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M0,0 L10,5 L0,10 z" class={`f-${c}`} />
			</marker>
		))}
	</defs>
	<circle cx={O.x} cy={O.y} r={R} class="s-muted w1" />
	<line x1={O.x - R - 10} y1={O.y} x2={O.x + R + 10} y2={O.y} class="s-grid w1" />
	<line x1={O.x} y1={O.y + R + 10} x2={O.x} y2={O.y - R - 10} class="s-grid w1" />
	<line x1={O.x} y1={O.y} x2={P.x} y2={P.y} class="s-fg w2" />
	<path d={`M${O.x + 30},${O.y} A30,30 0 0 0 ${O.x + 30 * Math.cos(th)},${O.y - 30 * Math.sin(th)}`} class="s-fg w1" />
	<text x={O.x + 36} y={O.y - 10} class="t-it">θ</text>
	<text x={(O.x + P.x) / 2 - 16} y={(O.y + P.y) / 2 - 4} class="t-sm">1</text>
	{/* the magnified step and its components */}
	<line x1={P.x} y1={P.y} x2={Q.x} y2={Q.y} class="s-fg w3" marker-end="url(#cv-fg)" />
	<line x1={P.x} y1={P.y} x2={Q.x} y2={P.y} class="s-sky w2" marker-end="url(#cv-sky)" />
	<line x1={Q.x} y1={P.y} x2={Q.x} y2={Q.y} class="s-amber w2" marker-end="url(#cv-amber)" />
	<circle cx={P.x} cy={P.y} r="5" class="f-fg" />
	<text x={P.x + 10} y={P.y + 6} class="t-sm t-b">P</text>
	<text x={(P.x + Q.x) / 2} y={P.y + 18} class="t-mid t-sm f-sky halo">−sin θ · dθ</text>
	<text x={Q.x - 8} y={(P.y + Q.y) / 2 + 4} class="t-end t-sm f-amber halo">cos θ · dθ</text>
	<text x={Q.x + 8} y={Q.y - 4} class="t-sm halo">step dθ (magnified)</text>
	<text x="330" y="70" class="t-sm f-muted">P is at (cos θ, sin θ). Turning by a tiny angle dθ</text>
	<text x="330" y="90" class="t-sm f-muted">moves P a distance dθ (arc = r × angle, r = 1),</text>
	<text x="330" y="110" class="t-sm f-muted">at right angles to the radius.</text>
	<text x="330" y="150" class="t-sm f-amber">height sin θ grows by cos θ · dθ</text>
	<text x="330" y="170" class="t-sm f-sky">across-position cos θ changes by −sin θ · dθ</text>
	<text x="330" y="210" class="t-sm t-b">so  d(sin θ)/dθ = cos θ</text>
	<text x="330" y="232" class="t-sm t-b">and d(cos θ)/dθ = −sin θ</text>
</svg>
