---
// Velocity–time graph of a ball thrown straight up at 12 m/s on Earth (up positive, a = −9.81 m/s²).
const O = { x: 80, y: 160 }, SX = 180, SY = 9;
const px = (t: number) => O.x + t * SX, py = (v: number) => O.y - v * SY;
const tTop = 12 / 9.81, tEnd = 2 * tTop;
---

<svg class="dg" viewBox="0 0 600 300" xmlns="http://www.w3.org/2000/svg">
	{[-12, -6, 0, 6, 12].map((v) => (
		<>
			<line x1={px(0)} y1={py(v)} x2={px(2.6)} y2={py(v)} class="s-grid w1" />
			<text x={px(0) - 8} y={py(v) + 4} class="t-end t-sm f-muted">{v}</text>
		</>
	))}
	<path d={`M${px(0)},${py(0)} L${px(0)},${py(12)} L${px(tTop)},${py(0)} Z`} class="f-green-soft" />
	<path d={`M${px(tTop)},${py(0)} L${px(tEnd)},${py(-12)} L${px(tEnd)},${py(0)} Z`} class="f-rose-soft" />
	<line x1={px(0)} y1={py(12)} x2={px(tEnd)} y2={py(-12)} class="s-amber w3" />
	<line x1={px(0)} y1={py(0)} x2={px(2.7)} y2={py(0)} class="s-fg w2" />
	<line x1={px(0)} y1={py(-13.5)} x2={px(0)} y2={py(14)} class="s-fg w2" />
	{[0.5, 1, 1.5, 2, 2.5].map((t) => <text x={px(t)} y={py(0) - 6} class="t-mid t-sm f-muted">{t}</text>)}
	<text x={px(2.72)} y={py(0) + 4} class="t-sm">t (s)</text>
	<text x="24" y={py(0)} class="t-mid t-sm" transform={`rotate(-90 24 ${py(0)})`}>velocity (m/s, up +)</text>
	<circle cx={px(tTop)} cy={py(0)} r="5" class="f-fg" />
	<text x={px(0.08)} y={py(-8)} class="t-sm t-b">● top of the throw: v = 0 at 1.22 s</text>
	<text x={px(0.38)} y={py(3.2)} class="t-mid t-b f-green">+7.34 m</text>
	<text x={px(tTop + 0.85)} y={py(-3.6)} class="t-mid t-b f-rose">−7.34 m</text>
	<text x={px(1.6)} y={py(9)} class="t-sm f-amber">slope = −9.81 m/s² throughout</text>
	<text x={px(0)} y="292" class="t-sm f-muted">Up and down take equal times, and it lands at the same speed it was thrown.</text>
</svg>
