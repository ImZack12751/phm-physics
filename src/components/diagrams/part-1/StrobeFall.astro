---
// Strobe pictures of a dropped ball every 0.1 s: on Earth (9.81 m/s²) and aboard the Hail Mary (14.7 m/s²).
// Gaps grow in the ratio 1 : 3 : 5 : 7 : 9.
const TOP = 50, SCALE = 1.45; // px per cm
const cols = [
	{ x: 170, g: 9.81, name: 'Earth, 1 g', cls: 'f-sky' },
	{ x: 400, g: 14.7, name: 'Hail Mary, 1.5 g', cls: 'f-amber' },
];
const times = [0, 0.1, 0.2, 0.3, 0.4];
const cm = (g: number, t: number) => 50 * g * t * t; // ½ g t² in cm
---

<svg class="dg" viewBox="0 0 600 320" xmlns="http://www.w3.org/2000/svg">
	<line x1="40" y1={TOP} x2="40" y2={TOP + 120 * SCALE} class="s-muted w1" />
	{[0, 40, 80, 120].map((c) => (
		<>
			<line x1="36" y1={TOP + c * SCALE} x2="560" y2={TOP + c * SCALE} class="s-grid w1" />
			<text x="34" y={TOP + c * SCALE + 4} class="t-end t-sm f-muted">{c}</text>
		</>
	))}
	<text x="14" y={TOP + 60 * SCALE} class="t-mid t-sm" transform={`rotate(-90 14 ${TOP + 60 * SCALE})`}>distance fallen (cm)</text>
	{
		cols.map((c) => (
			<>
				<text x={c.x} y="30" class="t-mid t-b">{c.name}</text>
				{times.map((t) => {
					const y = TOP + cm(c.g, t) * SCALE;
					return y < TOP + 125 * SCALE ? (
						<>
							<circle cx={c.x} cy={y} r="5" class={c.cls} />
							{t === 0 ? (
								<text x={c.x - 14} y={y + 4} class="t-end t-sm f-muted">released</text>
							) : (
								<text x={c.x + 16} y={y + (t === 0.1 ? 8 : 4)} class="t-sm halo">{`${t.toFixed(1)} s · ${(cm(c.g, t) + 1e-9).toFixed(1)} cm`}</text>
							)}
						</>
					) : null;
				})}
			</>
		))
	}
	<text x="300" y="312" class="t-mid t-sm f-muted">Equal times, growing gaps (1 : 3 : 5 : 7 …). At 1.5 g every gap is 1.5 times bigger.</text>
</svg>
