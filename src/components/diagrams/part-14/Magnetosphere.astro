---
// Earth's magnetosphere, schematic. Solar wind arrives from the left; the magnetopause sits about 10 Earth radii
// sunward, where the wind's pressure ρv² balances the field's magnetic pressure, and is drawn out into a long tail on
// the night side. Two shaded belts near Earth stand for the Van Allen belts of trapped particles.
const head = (x1: number, y1: number, x2: number, y2: number, s = 8) => {
	const a = Math.atan2(y2 - y1, x2 - x1), c = Math.cos(a), n = Math.sin(a);
	return `${x2},${y2} ${x2 - s * c + (s / 2) * n},${y2 - s * n - (s / 2) * c} ${x2 - s * c - (s / 2) * n},${y2 - s * n + (s / 2) * c}`;
};
const EX = 330, EY = 140, s = 12; // px per Earth radius
const MP = EX - 10 * s; // magnetopause nose
const belt = (r1: number, r2: number) => {
	const arc = (r: number, sweep: number, a0: number, a1: number) => {
		const p = (a: number) => `${(EX + r * s * Math.cos(a)).toFixed(1)} ${(EY - r * s * Math.sin(a)).toFixed(1)}`;
		return { p0: p(a0), p1: p(a1), r: r * s, sweep };
	};
	const A = 1.05;
	const o1 = arc(r2, 0, Math.PI - A, Math.PI + A), i1 = arc(r1, 1, Math.PI + A, Math.PI - A);
	const o2 = arc(r2, 0, -A, A), i2 = arc(r1, 1, A, -A);
	return [
		`M ${o1.p0} A ${o1.r} ${o1.r} 0 0 0 ${o1.p1} L ${i1.p0} A ${i1.r} ${i1.r} 0 0 1 ${i1.p1} Z`,
		`M ${o2.p0} A ${o2.r} ${o2.r} 0 0 0 ${o2.p1} L ${i2.p0} A ${i2.r} ${i2.r} 0 0 1 ${i2.p1} Z`,
	];
};
const inner = belt(1.3, 2.6), outer = belt(3.4, 6);
---

<svg class="dg" viewBox="0 0 600 280" xmlns="http://www.w3.org/2000/svg">
	<path d="M -40 -20 A 90 170 0 0 1 -40 300" class="f-amber-soft" />
	<text x="12" y="252" class="t-sm f-amber">Sun (far away)</text>
	{[50, 95, 140, 185, 230].map((y) => (
		<>
			<line x1="62" y1={y} x2={y === 140 ? MP - 14 : 150} y2={y} class="s-amber w2" />
			<polygon points={head(62, y, y === 140 ? MP - 10 : 156, y)} class="f-amber" />
		</>
	))}
	<text x="64" y="30" class="t-sm f-amber t-b">solar wind, 250–750 km/s</text>
	<path d={`M 600 22 C 470 22, ${MP} 40, ${MP} ${EY} C ${MP} 240, 470 258, 600 258`} class="s-sky w3" fill="none" />
	<text x={MP + 8} y="64" class="t-sm f-sky t-b halo">magnetopause</text>
	{[6, 8].map((r) => (
		<path d={`M 600 ${EY - r * s * 0.9} C 480 ${EY - r * s * 0.9}, ${EX - r * s} ${EY - r * s * 0.8}, ${EX - r * s * 0.55} ${EY} C ${EX - r * s} ${EY + r * s * 0.8}, 480 ${EY + r * s * 0.9}, 600 ${EY + r * s * 0.9}`} class="s-violet w1 dash" fill="none" />
	))}
	{inner.map((d) => <path d={d} class="f-rose-soft" />)}
	{outer.map((d) => <path d={d} class="f-green-soft" />)}
	<circle cx={EX} cy={EY} r={s} class="f-sky" />
	<text x={EX} y={EY + 32} class="t-mid t-sm halo">Earth</text>
	<line x1={MP} y1={EY + 8} x2={EX - s} y2={EY + 8} class="s-fg w1" />
	<text x={(MP + EX) / 2 - 20} y={EY - 6} class="t-mid t-sm halo">≈ 10 Earth radii</text>
	<text x="590" y="150" class="t-end t-sm f-violet halo">tail</text>
	<text x={EX + 6 * s + 6} y={EY - 52} class="t-sm f-green halo">Van Allen belts:</text>
	<text x={EX + 6 * s + 6} y={EY - 37} class="t-sm f-green halo">trapped particles</text>
	<text x="300" y="276" class="t-mid t-sm">where the wind's push ρv² equals the field's magnetic pressure, the wind is turned aside</text>
</svg>
