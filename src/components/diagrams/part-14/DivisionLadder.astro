---
// Converting 3043 to base six by repeated division: 3043 ÷ 6 = 507 r 1, 507 ÷ 6 = 84 r 3, 84 ÷ 6 = 14 r 0,
// 14 ÷ 6 = 2 r 2, 2 ÷ 6 = 0 r 2. Reading the remainders from the bottom up gives 22031.
const rows: [number, number, number][] = [];
for (let n = 3043; n > 0; n = Math.floor(n / 6)) rows.push([n, Math.floor(n / 6), n % 6]);
const Y0 = 46, H = 38;
const head = (x1: number, y1: number, x2: number, y2: number, s = 9) => {
	const a = Math.atan2(y2 - y1, x2 - x1), c = Math.cos(a), n = Math.sin(a);
	return `${x2},${y2} ${x2 - s * c + (s / 2) * n},${y2 - s * n - (s / 2) * c} ${x2 - s * c - (s / 2) * n},${y2 - s * n + (s / 2) * c}`;
};
const yLast = Y0 + (rows.length - 1) * H;
---

<svg class="dg" viewBox="0 0 600 270" xmlns="http://www.w3.org/2000/svg">
	<text x="150" y="22" class="t-mid t-sm t-b">divide by 6</text>
	<text x="330" y="22" class="t-mid t-sm t-b">quotient</text>
	<text x="440" y="22" class="t-mid t-sm t-b">remainder</text>
	{rows.map(([n, qt, r], i) => (
		<>
			<text x="190" y={Y0 + i * H + 6} class="t-end t-lg">{n} ÷ 6</text>
			<text x="250" y={Y0 + i * H + 6} class="t-mid t-lg">=</text>
			<text x="330" y={Y0 + i * H + 6} class="t-mid t-lg">{qt}</text>
			<text x="380" y={Y0 + i * H + 6} class="t-mid t-sm f-muted">rem.</text>
			<circle cx="440" cy={Y0 + i * H} r="15" class="f-amber-soft" />
			<text x="440" y={Y0 + i * H + 6} class="t-mid t-lg t-b">{r}</text>
		</>
	))}
	<line x1="490" y1={yLast} x2="490" y2={Y0 + 6} class="s-rose w3" />
	<polygon points={head(490, yLast, 490, Y0 - 6, 12)} class="f-rose" />
	<text x="502" y={(Y0 + yLast) / 2 - 6} class="t-sm f-rose t-b">read</text>
	<text x="502" y={(Y0 + yLast) / 2 + 10} class="t-sm f-rose t-b">upwards</text>
	<text x="300" y="250" class="t-mid t-sm">stop when the quotient reaches 0: 3043 = 22031 in base six</text>
</svg>
