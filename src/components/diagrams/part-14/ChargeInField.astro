---
// Left: a uniform field into the page (grid of crosses). A positive charge at the bottom of its circular path moves
// right; the force qvB points up, towards the centre, so the path is a circle of radius r = mv/qB.
// Right: a field pointing right; a charge with some velocity along the field spirals around the field line (helix).
const head = (x1: number, y1: number, x2: number, y2: number, s = 9) => {
	const a = Math.atan2(y2 - y1, x2 - x1), c = Math.cos(a), n = Math.sin(a);
	return `${x2},${y2} ${x2 - s * c + (s / 2) * n},${y2 - s * n - (s / 2) * c} ${x2 - s * c - (s / 2) * n},${y2 - s * n + (s / 2) * c}`;
};
const CX = 150, CY = 130, r = 70;
const crosses: { x: number; y: number }[] = [];
for (let x = 30; x <= 270; x += 40) for (let y = 40; y <= 220; y += 36) crosses.push({ x, y });
const Q = { x: CX, y: CY + r };
// helix: x from 340 to 580, radius 30 projected as a sine wave of amplitude 30 around y = 130
let hel = '';
for (let i = 0; i <= 240; i++) {
	const x = 340 + i, ph = (i / 60) * 2 * Math.PI;
	hel += `${i ? 'L' : 'M'} ${x} ${(130 + 30 * Math.cos(ph)).toFixed(1)} `;
}
---

<svg class="dg" viewBox="0 0 600 270" xmlns="http://www.w3.org/2000/svg">
	{crosses.map((p) => (
		<>
			<line x1={p.x - 4} y1={p.y - 4} x2={p.x + 4} y2={p.y + 4} class="s-muted w1" />
			<line x1={p.x - 4} y1={p.y + 4} x2={p.x + 4} y2={p.y - 4} class="s-muted w1" />
		</>
	))}
	<text x="150" y="20" class="t-mid t-sm t-b">field B into the page (×)</text>
	<circle cx={CX} cy={CY} r={r} class="s-sky w2 dash" fill="none" />
	<line x1={CX} y1={CY} x2={CX + r * 0.7071} y2={CY - r * 0.7071} class="s-fg w1" />
	<text x={CX + 18} y={CY - 4} class="t-sm halo">r = mv/qB</text>
	<line x1={Q.x} y1={Q.y} x2={Q.x + 54} y2={Q.y} class="s-green w3" />
	<polygon points={head(Q.x, Q.y, Q.x + 62, Q.y, 11)} class="f-green" />
	<text x={Q.x + 66} y={Q.y + 18} class="t-sm f-green t-b halo">v</text>
	<line x1={Q.x} y1={Q.y} x2={Q.x} y2={Q.y - 38} class="s-rose w3" />
	<polygon points={head(Q.x, Q.y, Q.x, Q.y - 46, 11)} class="f-rose" />
	<text x={Q.x - 8} y={Q.y - 30} class="t-end t-sm f-rose t-b halo">F = qvB</text>
	<circle cx={Q.x} cy={Q.y} r="9" class="f-amber" />
	<text x={Q.x} y={Q.y + 4} class="t-mid t-sm t-b">+</text>
	<text x="150" y="240" class="t-mid t-sm">force at right angles to v: the speed</text>
	<text x="150" y="256" class="t-mid t-sm">stays the same, the path bends into a circle</text>
	<line x1="330" y1="130" x2="590" y2="130" class="s-violet w2" />
	<polygon points={head(330, 130, 592, 130, 11)} class="f-violet" />
	<line x1="330" y1="70" x2="590" y2="70" class="s-violet w1 dash" />
	<line x1="330" y1="190" x2="590" y2="190" class="s-violet w1 dash" />
	<text x="460" y="20" class="t-mid t-sm t-b">field B to the right</text>
	<path d={hel} class="s-sky w2" fill="none" />
	<text x="460" y="226" class="t-mid t-sm">velocity along B is untouched:</text>
	<text x="460" y="242" class="t-mid t-sm">the charge spirals along the field line</text>
</svg>
