---
// Two number lines from 0 to 1. Top: base ten, ticks at tenths. Bottom: base six, ticks at sixths (0.1₆ … 0.5₆).
// Markers at 1/2, 1/3 and 1/4: 1/3 falls on a tick in base six (0.2₆) but between ticks forever in base ten
// (0.333…); 1/5 is the reverse (0.2 in base ten, 0.1111…₆ in base six).
const L = 60, R = 560;
const X = (v: number) => L + v * (R - L);
const Ytop = 80, Ybot = 190;
const marks = [
	{ v: 1 / 2, n: '½', t10: '0.5', t6: '0.3₆', b: 0, a: 0 },
	{ v: 1 / 3, n: '⅓', t10: '0.333…', t6: '0.2₆', b: 0, a: 0 },
	{ v: 1 / 4, n: '¼', t10: '0.25', t6: '0.13₆', b: 1, a: 1 },
	{ v: 1 / 5, n: '⅕', t10: '0.2', t6: '0.111…₆', b: 2, a: 2 },
];
---

<svg class="dg" viewBox="0 0 600 270" xmlns="http://www.w3.org/2000/svg">
	<text x={R} y={Ytop - 14} class="t-end t-sm t-b">base ten: tenths</text>
	<line x1={L} y1={Ytop} x2={R} y2={Ytop} class="s-fg w2" />
	{Array.from({ length: 11 }, (_, i) => <line x1={X(i / 10)} y1={Ytop - 8} x2={X(i / 10)} y2={Ytop + 8} class="s-fg w1" />)}
	<text x={X(0)} y={Ytop + 24} class="t-mid t-sm">0</text>
	<text x={X(1)} y={Ytop + 24} class="t-mid t-sm">1</text>
	<text x={R} y={Ybot - 14} class="t-end t-sm t-b">base six: sixths</text>
	<line x1={L} y1={Ybot} x2={R} y2={Ybot} class="s-fg w2" />
	{Array.from({ length: 7 }, (_, i) => <line x1={X(i / 6)} y1={Ybot - 8} x2={X(i / 6)} y2={Ybot + 8} class="s-fg w1" />)}
	<text x={X(0)} y={Ybot + 24} class="t-mid t-sm">0</text>
	<text x={X(1)} y={Ybot + 24} class="t-mid t-sm">1</text>
	{marks.map((m) => (
		<>
			<line x1={X(m.v)} y1={Ytop + 8} x2={X(m.v)} y2={Ybot - 8} class="s-muted w1 dash" />
			<circle cx={X(m.v)} cy={Ytop} r="5" class="f-rose" />
			<circle cx={X(m.v)} cy={Ybot} r="5" class="f-sky" />
			<text x={X(m.v)} y={Ytop - 14 - m.a * 15} class="t-mid t-sm f-rose halo">{m.n} = {m.t10}</text>
			<text x={X(m.v)} y={Ybot + 40 + m.b * 15} class="t-mid t-sm f-sky halo">{m.n} = {m.t6}</text>
		</>
	))}
	<text x="300" y="14" class="t-mid t-sm f-muted">a fraction ends if its denominator's prime factors divide the base: 10 = 2 × 5, 6 = 2 × 3</text>
</svg>
