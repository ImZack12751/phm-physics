---
// Bar chart (log scale) of measured speeds of sound (OpenStax Table 17.1) plus our calculated xenon and Erid ammonia.
const L = 210, R = 560, T = 26, H = 17;
const lo = Math.log10(40), hi = Math.log10(10000);
const X = (v: number) => L + ((Math.log10(v) - lo) / (hi - lo)) * (R - L);
const bars = [
	{ n: 'vulcanized rubber', v: 54, k: 's' },
	{ n: 'xenon, 20 °C (calculated)', v: 176, k: 'g' },
	{ n: 'carbon dioxide', v: 259, k: 'g' },
	{ n: 'air, 0 °C', v: 331, k: 'g' },
	{ n: 'air, 20 °C', v: 343, k: 'g' },
	{ n: 'ammonia on Erid (our estimate)', v: 556, k: 'g', hi: true },
	{ n: 'helium', v: 965, k: 'g' },
	{ n: 'hydrogen', v: 1290, k: 'g' },
	{ n: 'fresh water', v: 1480, k: 'l' },
	{ n: 'sea water, human tissue', v: 1540, k: 'l' },
	{ n: 'lead', v: 1960, k: 's' },
	{ n: 'marble', v: 3810, k: 's' },
	{ n: 'aluminium', v: 5120, k: 's' },
	{ n: 'Pyrex glass', v: 5640, k: 's' },
	{ n: 'steel', v: 5960, k: 's' },
];
const cls: Record<string, string> = { g: 'f-sky', l: 'f-green', s: 'f-amber' };
---

<svg class="dg" viewBox="0 0 600 330" xmlns="http://www.w3.org/2000/svg">
	{[50, 100, 200, 500, 1000, 2000, 5000, 10000].map((v) => (
		<>
			<line x1={X(v)} y1={T - 6} x2={X(v)} y2={T + bars.length * H} class="s-grid w1" />
			<text x={X(v)} y={T + bars.length * H + 16} class="t-mid t-sm f-muted">{v >= 1000 ? `${v / 1000}k` : v}</text>
		</>
	))}
	<text x={(L + R) / 2} y={T + bars.length * H + 34} class="t-mid t-sm">speed of sound (m/s), logarithmic scale</text>
	{bars.map((b, i) => (
		<>
			<text x={L - 8} y={T + i * H + 12} class={`t-end t-sm ${b.hi ? 'f-rose t-b' : ''}`}>{b.n}</text>
			<rect x={L} y={T + i * H + 2} width={X(b.v) - L} height={H - 5} class={b.hi ? 'f-rose' : cls[b.k]} />
			<text x={X(b.v) + 5} y={T + i * H + 12} class="t-sm f-muted">{b.v}</text>
		</>
	))}
	<rect x={L} y="6" width="10" height="10" class="f-sky" /><text x={L + 14} y="15" class="t-sm">gases</text>
	<rect x={L + 70} y="6" width="10" height="10" class="f-green" /><text x={L + 84} y="15" class="t-sm">liquids</text>
	<rect x={L + 145} y="6" width="10" height="10" class="f-amber" /><text x={L + 159} y="15" class="t-sm">solids</text>
</svg>
