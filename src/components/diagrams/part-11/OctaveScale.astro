---
// A logarithmic frequency axis (20 Hz to 20 kHz) with the 88 piano keys (A0 = 27.5 Hz to C8 = 4186 Hz), the notes A
// at each octave, and the range of human hearing with its most sensitive band (2–5 kHz, OpenStax §17.3).
const L = 40, R = 570, lo = Math.log10(20), span = 3;
const X = (f: number) => L + ((Math.log10(f) - lo) / span) * (R - L);
const keys = Array.from({ length: 88 }, (_, k) => ({ f: 27.5 * 2 ** (k / 12), black: [1, 4, 6, 9, 11].includes(k % 12) }));
const edge = (k: number) => X(27.5 * 2 ** ((k - 0.5) / 12));
const As = [27.5, 55, 110, 220, 440, 880, 1760, 3520];
const ticks = [20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000];
const lab = (f: number) => (f >= 1000 ? `${f / 1000} k` : String(f));
---

<svg class="dg" viewBox="0 0 600 240" xmlns="http://www.w3.org/2000/svg">
	<rect x={edge(0)} y="34" width={edge(88) - edge(0)} height="40" class="f-sky-soft" />
	{keys.map((k, i) => k.black && <rect x={edge(i)} y="34" width={edge(i + 1) - edge(i)} height="24" class="f-bg" />)}
	<text x={edge(88) + 8} y="50" class="t-sm">piano: 88 keys,</text>
	<text x={edge(88) + 8} y="66" class="t-sm">27.5 Hz to 4186 Hz</text>
	{As.map((f) => (
		<>
			<line x1={X(f)} y1="74" x2={X(f)} y2="86" class="s-muted w1" />
			<circle cx={X(f)} cy="92" r={f === 440 ? 6 : 4} class={f === 440 ? 'f-amber' : 'f-sky'} />
			<text x={X(f)} y="112" class={`t-mid t-sm ${f === 440 ? 'f-amber t-b' : ''}`}>{f}</text>
		</>
	))}
	<text x={X(440)} y="20" class="t-mid t-sm f-amber">A4 = 440 Hz</text>
	<line x1={X(220)} y1="126" x2={X(440)} y2="126" class="s-fg w1" />
	<line x1={X(220)} y1="121" x2={X(220)} y2="131" class="s-fg w1" />
	<line x1={X(440)} y1="121" x2={X(440)} y2="131" class="s-fg w1" />
	<text x={(X(220) + X(440)) / 2} y="143" class="t-mid t-sm">×2: one octave</text>
	<text x={L} y="126" class="t-sm f-muted">the A's, evenly spaced:</text>
	<line x1={L} y1="160" x2={R} y2="160" class="s-fg w2" />
	{ticks.map((f) => (
		<>
			<line x1={X(f)} y1="155" x2={X(f)} y2="165" class="s-fg w1" />
			<text x={X(f)} y="180" class="t-mid t-sm f-muted">{lab(f)}</text>
		</>
	))}
	<text x={R} y="150" class="t-end t-sm f-muted">frequency (Hz)</text>
	<rect x={X(20)} y="192" width={X(20000) - X(20)} height="12" class="f-green-soft" />
	<rect x={X(2000)} y="192" width={X(5000) - X(2000)} height="12" class="f-green" />
	<text x={L} y="226" class="t-sm f-green">human hearing: 20 Hz to 20 kHz, about ten octaves</text>
	<text x={X(3200)} y="226" class="t-mid t-sm f-green">most sensitive</text>
</svg>
