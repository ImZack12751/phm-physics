---
// Schematic stress–strain curves: ductile steel (elastic line to yield 250 MPa, plastic rise to 400 MPa, then fracture)
// and brittle glass (straight line ending abruptly at ~41 MPa). Not to scale: the elastic part is stretched out.
const L = 70, R = 560, T = 30, B = 220;
const S = (mpa: number) => B - (mpa / 450) * (B - T);
const steel = `M${L},${B} L120,${S(250)} C150,${S(262)} 200,${S(300)} 260,${S(345)} C330,${S(395)} 390,${S(402)} 440,${S(395)} C470,${S(388)} 490,${S(370)} 505,${S(340)}`;
const glassEnd = [L + 52, S(41) - 18];
---

<svg class="dg" viewBox="0 0 600 270" xmlns="http://www.w3.org/2000/svg">
	<line x1={L} y1={T - 6} x2={L} y2={B} class="s-fg w1" />
	<line x1={L} y1={B} x2={R} y2={B} class="s-fg w1" />
	<text x={(L + R) / 2} y={B + 36} class="t-mid t-sm">strain ε (schematic, not to scale)</text>
	<text x="18" y={(T + B) / 2} class="t-mid t-sm" transform={`rotate(-90 18 ${(T + B) / 2})`}>stress σ</text>
	{[0, 100, 200, 300, 400].map((m) => (
		<>
			<line x1={L - 5} y1={S(m)} x2={L} y2={S(m)} class="s-fg w1" />
			<text x={L - 8} y={S(m) + 4} class="t-end t-sm f-muted">{m}</text>
		</>
	))}
	<text x={L - 8} y={T - 10} class="t-end t-sm f-muted">MPa</text>
	<path d={steel} class="s-amber w3" fill="none" />
	<text x="512" y={S(340) - 2} class="t-sm f-amber">✕ fracture</text>
	<circle cx="120" cy={S(250)} r="4" class="f-amber" />
	<text x="128" y={S(250) + 18} class="t-sm f-amber">yield strength, 250 MPa</text>
	<text x="390" y={S(402) - 10} class="t-mid t-sm f-amber">ultimate tensile strength, 400 MPa</text>
	<text x="360" y={S(300)} class="t-mid t-sm f-muted">plastic: permanent stretch</text>
	<text x="84" y={S(150)} class="t-sm f-amber">elastic,</text>
	<text x="84" y={S(150) + 16} class="t-sm f-amber">slope Y</text>
	<line x1={L} y1={B} x2={glassEnd[0]} y2={S(41)} class="s-sky w3" />
	<text x={glassEnd[0] - 4} y={S(41) + 4} class="t-sm f-sky">✕</text>
	<text x={glassEnd[0] + 12} y={S(41) + 4} class="t-sm f-sky">glass breaks, about 41 MPa, no warning</text>
	<text x="430" y={S(170)} class="t-sm f-amber">steel: ductile</text>
	<text x="430" y={S(170) + 18} class="t-sm f-sky">glass: brittle</text>
</svg>
