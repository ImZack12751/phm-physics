---
// Tensile strengths (MPa) on a log scale from 1 to 300 000, with Rocky's partition in bending (our Example 5) highlighted.
const L = 230, R = 545, T = 14, H = 19;
const lo = 0, hi = Math.log10(3e5);
const X = (v: number) => L + ((Math.log10(v) - lo) / (hi - lo)) * (R - L);
const bars = [
	{ n: 'concrete (tension)', v: 2 },
	{ n: 'annealed glass', v: 41 },
	{ n: 'bone', v: 130 },
	{ n: 'human hair', v: 200 },
	{ n: 'aluminium alloy 6061', v: 300 },
	{ n: 'structural steel', v: 400 },
	{ n: 'spider silk', v: 1000 },
	{ n: 'Kevlar fibre', v: 2920 },
	{ n: 'optical-fibre glass', v: 4100 },
	{ n: 'carbon fibre', v: 4137 },
	{ n: 'Rocky’s flat partition needs', v: 43500, hi: true },
	{ n: 'graphene (perfect, intrinsic)', v: 130000 },
];
const B = T + bars.length * H;
---

<svg class="dg" viewBox="0 0 600 290" xmlns="http://www.w3.org/2000/svg">
	{[1, 10, 100, 1000, 10000, 100000].map((v) => (
		<>
			<line x1={X(v)} y1={T - 4} x2={X(v)} y2={B} class="s-grid w1" />
			<text x={X(v)} y={B + 16} class="t-mid t-sm f-muted">{v >= 1000 ? `${v / 1000}k` : v}</text>
		</>
	))}
	{bars.map((b, i) => (
		<>
			<text x={L - 8} y={T + i * H + 13} class={`t-end t-sm ${b.hi ? 'f-rose t-b' : ''}`}>{b.n}</text>
			<rect x={L} y={T + i * H + 3} width={X(b.v) - L} height={H - 6} class={b.hi ? 'f-rose' : 'f-amber'} />
			<text x={X(b.v) + 5} y={T + i * H + 13} class="t-sm f-muted">{b.v >= 10000 ? `${b.v / 1000}k` : b.v}</text>
		</>
	))}
	<text x={(L + R) / 2} y={B + 36} class="t-mid t-sm">tensile strength (MPa), logarithmic scale</text>
</svg>
