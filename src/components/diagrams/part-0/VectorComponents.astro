---
// Resolving a vector into x and y components.
const O = { x: 80, y: 250 }, V = { x: 300, y: -170 };
const tip = { x: O.x + V.x, y: O.y + V.y };
const ang = Math.atan2(-V.y, V.x);
const R = 50;
---

<svg class="dg" viewBox="0 0 560 300" xmlns="http://www.w3.org/2000/svg">
	<defs>
		{['fg', 'amber', 'sky'].map((c) => (
			<marker id={`vc-${c}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
				<path d="M0,0 L10,5 L0,10 z" class={`f-${c}`} />
			</marker>
		))}
	</defs>
	<line x1={O.x - 20} y1={O.y} x2={O.x + 380} y2={O.y} class="s-grid w1" />
	<line x1={O.x} y1={O.y + 20} x2={O.x} y2={O.y - 196} class="s-grid w1" />
	<text x={O.x + 384} y={O.y + 5} class="t-it f-muted">x</text>
	<text x={O.x - 12} y={O.y - 186} class="t-it t-mid f-muted">y</text>

	<line x1={O.x} y1={O.y} x2={tip.x} y2={O.y} class="s-sky w3" marker-end="url(#vc-sky)" />
	<line x1={tip.x} y1={O.y} x2={tip.x} y2={tip.y} class="s-amber w3" marker-end="url(#vc-amber)" />
	<line x1={O.x} y1={O.y} x2={tip.x} y2={tip.y} class="s-fg w3" marker-end="url(#vc-fg)" />
	<path d={`M${O.x + R},${O.y} A${R},${R} 0 0 0 ${(O.x + R * Math.cos(ang)).toFixed(1)},${(O.y - R * Math.sin(ang)).toFixed(1)}`} class="s-fg w1" />
	<text x={O.x + R + 8} y={O.y - 8} class="t-it">θ</text>

	<text x={O.x + V.x / 2 - 30} y={O.y + V.y / 2 - 12} class="t-b">A</text>
	<text x={O.x + V.x / 2} y={O.y + 24} class="t-mid t-b f-sky">A<tspan baseline-shift="sub" font-size="11">x</tspan> = A cos θ</text>
	<text x={tip.x + 12} y={O.y + V.y / 2} class="t-b f-amber">A<tspan baseline-shift="sub" font-size="11">y</tspan> = A sin θ</text>
	<text x={tip.x + 12} y={tip.y - 10} class="t-sm f-muted">tip at (A<tspan baseline-shift="sub" font-size="11">x</tspan>, A<tspan baseline-shift="sub" font-size="11">y</tspan>)</text>
	<text x="20" y="22" class="t-sm f-muted">A vector is the same as "go A<tspan baseline-shift="sub" font-size="11">x</tspan> along x, then A<tspan baseline-shift="sub" font-size="11">y</tspan> along y".</text>
</svg>
