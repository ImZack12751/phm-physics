---
// A ball falling through air at three moments. Weight stays the same; drag grows with speed until it balances the weight.
const head = (x: number, y: number, dir: number) => `${x},${y} ${x - 7},${y - dir * 12} ${x + 7},${y - dir * 12}`;
const W = 80; // arrow length for the weight
const BALL_Y = 165;
const shots = [
	{ x: 110, f: 0, title: 'just released', v: 'v = 0', net: 'net force = weight: a = g' },
	{ x: 300, f: 0.5, title: 'speeding up', v: 'v ≈ 0.7 × terminal', net: 'net force smaller: a = g/2' },
	{ x: 490, f: 1, title: 'terminal velocity', v: 'v = terminal', net: 'net force zero: a = 0' },
];
---

<svg class="dg" viewBox="0 0 600 340" xmlns="http://www.w3.org/2000/svg">
	{
		shots.map((s) => (
			<>
				<text x={s.x} y="26" class="t-mid t-b">{s.title}</text>
				<text x={s.x} y="46" class="t-mid t-sm f-muted">{s.v}</text>
				<circle cx={s.x} cy={BALL_Y} r="16" class="f-sky-soft s-sky w2" />
				<line x1={s.x} y1={BALL_Y + 16} x2={s.x} y2={BALL_Y + 16 + W - 12} class="s-rose w3" />
				<polygon points={head(s.x, BALL_Y + 16 + W, 1)} class="f-rose" />
				<text x={s.x + 12} y={BALL_Y + 16 + W - 10} class="t-sm f-rose">weight</text>
				{s.f > 0 && (
					<>
						<line x1={s.x} y1={BALL_Y - 16} x2={s.x} y2={BALL_Y - 16 - s.f * W + 12} class="s-green w3" />
						<polygon points={head(s.x, BALL_Y - 16 - s.f * W, -1)} class="f-green" />
						<text x={s.x + 12} y={BALL_Y - 16 - s.f * W + 14} class="t-sm f-green">drag</text>
					</>
				)}
				<text x={s.x} y="316" class="t-mid t-sm">{s.net}</text>
			</>
		))
	}
</svg>
