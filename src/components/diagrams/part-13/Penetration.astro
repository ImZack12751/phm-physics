---
// Alpha, beta and gamma aimed at paper, aluminium (a few mm) and lead. Alpha stops at the paper, beta in the aluminium,
// gamma is weakened by the lead (thinner arrow emerging).
const head = (x1: number, y1: number, x2: number, y2: number, s = 10) => {
	const a = Math.atan2(y2 - y1, x2 - x1), c = Math.cos(a), n = Math.sin(a);
	return `${x2},${y2} ${x2 - s * c + (s / 2) * n},${y2 - s * n - (s / 2) * c} ${x2 - s * c - (s / 2) * n},${y2 - s * n + (s / 2) * c}`;
};
const paper = 200, al = 300, pb = 400, pbW = 70;
const rays = [
	{ y: 80, n: 'alpha (α)', s: 'helium nuclei', end: paper - 2, cls: 'amber' },
	{ y: 140, n: 'beta (β)', s: 'electrons', end: al + 8, cls: 'sky' },
	{ y: 200, n: 'gamma (γ)', s: 'photons', end: pb - 2, cls: 'rose' },
];
---

<svg class="dg" viewBox="0 0 600 300" xmlns="http://www.w3.org/2000/svg">
	<rect x={paper} y="45" width="3" height="190" class="f-fg" />
	<rect x={al} y="45" width="16" height="190" class="f-muted" />
	<rect x={pb} y="45" width={pbW} height="190" class="f-violet" />
	<text x={paper + 1} y="34" class="t-mid t-sm">paper</text>
	<text x={al + 8} y="22" class="t-mid t-sm">aluminium</text>
	<text x={al + 8} y="36" class="t-mid t-sm">(a few mm)</text>
	<text x={pb + pbW / 2} y="34" class="t-mid t-sm">lead (several cm)</text>
	{rays.map((r) => (
		<>
			<text x="16" y={r.y - 4} class={`t-sm t-b f-${r.cls}`}>{r.n}</text>
			<text x="16" y={r.y + 12} class="t-sm f-muted">{r.s}</text>
			<line x1="100" y1={r.y} x2={r.end - 9} y2={r.y} class={`s-${r.cls} w3`} />
			<polygon points={head(100, r.y, r.end, r.y, 12)} class={`f-${r.cls}`} />
		</>
	))}
	<line x1={pb} y1="200" x2={pb + pbW} y2="200" class="s-rose w2 dash" />
	<line x1={pb + pbW} y1="200" x2="555" y2="200" class="s-rose w1" />
	<polygon points={head(pb + pbW, 200, 565, 200, 8)} class="f-rose" />
	<text x="540" y="226" class="t-mid t-sm f-rose">weakened,</text>
	<text x="540" y="242" class="t-mid t-sm f-rose">not stopped</text>
	<text x={pb + pbW / 2} y="256" class="t-mid t-sm f-rose">halved by each 0.86 cm of lead at 1 MeV</text>
	<text x="300" y="290" class="t-mid t-sm f-muted">charged particles have a range; photons only have odds</text>
</svg>
