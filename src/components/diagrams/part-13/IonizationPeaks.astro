---
// First ionization energies (eV, CRC via Wikipedia data page) for selected elements in order of Z.
// Noble gases amber, alkali metals sky, others muted; dashed line at xenon's 12.1 eV.
const data: [string, number, string][] = [
	['H', 13.6, 'o'], ['He', 24.59, 'n'], ['Li', 5.39, 'a'], ['C', 11.26, 'o'], ['N', 14.53, 'o'], ['O', 13.62, 'o'], ['Ne', 21.56, 'n'],
	['Na', 5.14, 'a'], ['Ar', 15.76, 'n'], ['K', 4.34, 'a'], ['Kr', 14.0, 'n'], ['Xe', 12.13, 'n'], ['Cs', 3.89, 'a'],
];
const L = 60, R = 580, T = 30, B = 230, max = 26;
const w = (R - L) / data.length;
const Y = (v: number) => B - (v / max) * (B - T);
const cls = { n: 'f-amber', a: 'f-sky', o: 'f-muted' } as Record<string, string>;
const xe = data.findIndex((d) => d[0] === 'Xe');
---

<svg class="dg" viewBox="0 0 600 290" xmlns="http://www.w3.org/2000/svg">
	{[0, 5, 10, 15, 20, 25].map((v) => (
		<>
			<line x1={L} y1={Y(v)} x2={R} y2={Y(v)} class="s-grid w1" />
			<text x={L - 6} y={Y(v) + 4} class="t-end t-sm f-muted">{v}</text>
		</>
	))}
	<line x1={L} y1={Y(12.13)} x2={L + (xe + 1) * w} y2={Y(12.13)} class="s-rose w1 dash" />
	{data.map(([s, v, k], i) => (
		<>
			<rect x={L + i * w + 6} y={Y(v)} width={w - 12} height={B - Y(v)} class={cls[k]} />
			<text x={L + i * w + w / 2} y={B + 16} class="t-mid t-sm t-b">{s}</text>
			<text x={L + i * w + w / 2} y={Y(v) - 5} class="t-mid t-sm">{v.toFixed(1)}</text>
		</>
	))}
	<text x="18" y={(T + B) / 2} class="t-mid t-sm" transform={`rotate(-90 18 ${(T + B) / 2})`}>energy to remove one electron (eV)</text>
	<rect x="40" y="256" width="12" height="12" class="f-amber" /><text x="58" y="266" class="t-sm">noble gas (full shell)</text>
	<rect x="210" y="256" width="12" height="12" class="f-sky" /><text x="228" y="266" class="t-sm">alkali metal (one extra electron)</text>
	<text x="580" y="266" class="t-end t-sm f-rose">dashed: xenon's 12.1 eV</text>
	<text x="320" y="286" class="t-mid t-sm f-muted">elements in order of atomic number (selection)</text>
</svg>
