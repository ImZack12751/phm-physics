---
// Blackbody spectra (Planck's law) for 4000 K, 5000 K and 5772 K (the Sun) on a common scale, with the visible band shaded
// and each peak marked: λmax = b/T (Wien), b = 2.898 × 10⁻³ m K.
const h = 6.62607015e-34, c = 299792458, k = 1.380649e-23, b = 2.897771955e-3;
const B = (l: number, T: number) => (2 * h * c * c) / l ** 5 / (Math.exp((h * c) / (l * k * T)) - 1);
const L = 60, R = 570, T0 = 30, BOT = 250, lMax = 2500e-9;
const Bmax = B(b / 5772, 5772);
const px = (l: number) => L + (l / lMax) * (R - L);
const py = (v: number) => BOT - (v / Bmax) * (BOT - T0 - 10);
const temps = [
	{ T: 5772, cls: 's-amber', fc: 'f-amber', label: '5772 K (the Sun)' },
	{ T: 5000, cls: 's-rose', fc: 'f-rose', label: '5000 K' },
	{ T: 4000, cls: 's-violet', fc: 'f-violet', label: '4000 K' },
];
const curve = (T: number) =>
	Array.from({ length: 300 }, (_, i) => {
		const l = 60e-9 + ((lMax - 60e-9) * i) / 299;
		return `${px(l).toFixed(1)},${py(B(l, T)).toFixed(1)}`;
	}).join(' ');
const rainbow = [[0, '#7c3aed'], [0.2, '#3b82f6'], [0.35, '#06b6d4'], [0.5, '#22c55e'], [0.65, '#eab308'], [0.82, '#f97316'], [1, '#dc2626']] as const;
---

<svg class="dg" viewBox="0 0 600 300" xmlns="http://www.w3.org/2000/svg">
	<defs>
		<linearGradient id="pc-vis" x1="0" x2="1" y1="0" y2="0">
			{rainbow.map(([o, col]) => <stop offset={o} stop-color={col} />)}
		</linearGradient>
	</defs>
	<rect x={px(400e-9)} y={T0} width={px(750e-9) - px(400e-9)} height={BOT - T0} fill="url(#pc-vis)" fill-opacity="0.18" />
	<text x={(px(400e-9) + px(750e-9)) / 2} y={BOT - 8} class="t-mid t-sm f-muted halo">visible</text>
	<line x1={L} y1={BOT} x2={R} y2={BOT} class="s-fg w2" />
	<line x1={L} y1={BOT} x2={L} y2={T0} class="s-fg w2" />
	{[500, 1000, 1500, 2000, 2500].map((nm) => (
		<>
			<line x1={px(nm * 1e-9)} y1={BOT} x2={px(nm * 1e-9)} y2={BOT + 5} class="s-fg w1" />
			<text x={px(nm * 1e-9)} y={BOT + 18} class="t-mid t-sm f-muted">{nm}</text>
		</>
	))}
	{temps.map((t) => (
		<>
			<polyline points={curve(t.T)} class={`${t.cls} w3`} fill="none" />
			<line x1={px(b / t.T)} y1={py(B(b / t.T, t.T))} x2={px(b / t.T)} y2={BOT} class={`${t.cls} w1 dash`} />
			<circle cx={px(b / t.T)} cy={py(B(b / t.T, t.T))} r="4" class={t.fc} />
			<text x={px(b / t.T) + 10} y={py(B(b / t.T, t.T)) - 4} class={`t-sm halo ${t.fc}`}>{t.label}: peak {Math.round((b / t.T) * 1e9)} nm</text>
		</>
	))}
	<text x={(L + R) / 2} y="292" class="t-mid t-sm">wavelength (nm)</text>
	<text x="22" y={(T0 + BOT) / 2} class="t-mid t-sm" transform={`rotate(-90 22 ${(T0 + BOT) / 2})`}>power per wavelength</text>
	<text x={R} y="120" class="t-end t-sm f-muted">hotter: brighter at every</text>
	<text x={R} y="138" class="t-end t-sm f-muted">wavelength, peak moves left</text>
</svg>
