---
// Simulation: thrust F = ṁ v_e for different kinds of engine, the acceleration it gives a ship, and the exhaust power
// needed: ½ F v_e for a material exhaust, F c for light.
---

<div
	class="sim tl"
	data-title="Thrust lab"
	data-description="Choose an engine type (solid booster, 2.63 km/s exhaust; hydrogen–oxygen RS-25, 4.44 km/s; ion thruster, 30 km/s; or an Astrophage light drive, exhaust at the speed of light), the mass of propellant thrown out per second (logarithmic, from 1 microgram to 10 tonnes per second) and the ship's mass (logarithmic, 100 kg to 10 million kg). The readout gives the thrust F = ṁ v_e, the acceleration F/m in m/s² and in g, whether the engine could lift the ship off Earth, and the power carried by the exhaust (½ F v_e, or F c for light) with the watts needed per newton of thrust. Bars compare the acceleration with 1 g and 1.5 g."
>
	<p class="sim-title">Simulation: thrust lab</p>
	<p class="sim-help">Pick an engine, a flow rate and a ship. The defaults are the Hail Mary late in the trip: 6.043 g/s of light-drive exhaust on a 123-tonne ship. Then try a chemical engine with the same flow rate.</p>
	<div class="sim-controls">
		<label>Engine <select class="tl-e">
			<option value="3">Astrophage light drive (c)</option>
			<option value="0">Solid booster (2.63 km/s)</option>
			<option value="1">Hydrogen–oxygen, RS-25 (4.44 km/s)</option>
			<option value="2">Ion thruster (30 km/s)</option>
		</select></label>
		<label>Mass flow ṁ <input type="range" class="tl-m" min="-9" max="4" step="0.0001" value="-2.2187" /> <output class="tl-mv"></output></label>
		<label>Ship mass <input type="range" class="tl-s" min="2" max="7" step="0.001" value="5.0905" /> <output class="tl-sv"></output></label>
	</div>
	<svg class="dg tl-svg" viewBox="0 0 600 130" role="img" aria-label="Bar comparing the ship's acceleration with 1 g and 1.5 g"></svg>
	<div class="readout tl-out" aria-live="polite"></div>
</div>

<script>
	const c = 299792458, g0 = 9.80665;
	const ENG = [
		{ n: 'solid booster', ve: 2630 },
		{ n: 'RS-25', ve: 4436 },
		{ n: 'ion thruster', ve: 30000 },
		{ n: 'light drive', ve: c },
	];
	const sci = (x: number, d = 3) => {
		if (x === 0) return '0';
		const e = Math.floor(Math.log10(Math.abs(x)));
		if (e >= -2 && e < 4) return x.toPrecision(Math.max(d, e + 1));
		return `${(x / 10 ** e).toFixed(d - 1)} × 10<sup>${e}</sup>`;
	};
	const sup = (n: number) => String(n).split('').map((d) => (d === '-' ? '⁻' : '⁰¹²³⁴⁵⁶⁷⁸⁹'[+d])).join('');
	const plain = (x: number) => {
		const e = Math.floor(Math.log10(x));
		return e < 4 ? x.toPrecision(Math.max(3, e + 1)) : `${(x / 10 ** e).toFixed(2)} × 10${sup(e)}`;
	};
	const mass = (kg: number) => (kg >= 1 ? `${plain(kg)} kg` : kg >= 1e-3 ? `${(kg * 1000).toPrecision(3)} g` : kg >= 1e-6 ? `${(kg * 1e6).toPrecision(3)} mg` : `${(kg * 1e9).toPrecision(3)} µg`);
	document.querySelectorAll<HTMLElement>('.sim.tl').forEach((root) => {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('.tl-svg'), out = q<HTMLElement>('.tl-out');
		const Es = q<HTMLSelectElement>('.tl-e'), Ms = q<HTMLInputElement>('.tl-m'), Ss = q<HTMLInputElement>('.tl-s');
		const NS = 'http://www.w3.org/2000/svg';
		const el = (tag: string, at: Record<string, string | number>, text?: string) => {
			const e = document.createElementNS(NS, tag);
			Object.entries(at).forEach(([k, v]) => e.setAttribute(k, String(v)));
			if (text) e.textContent = text;
			svg.append(e);
			return e;
		};
		const L = 30, R = 570, Y = 60;
		function draw() {
			const eng = ENG[+Es.value], mdot = 10 ** +Ms.value, m = 10 ** +Ss.value;
			q('.tl-mv').textContent = `${mass(mdot)}/s`;
			q('.tl-sv').textContent = mass(m);
			const F = mdot * eng.ve, a = F / m, light = eng.ve === c;
			const P = light ? F * c : 0.5 * F * eng.ve;
			// log scale for acceleration from 1e-6 to 1e3 m/s²
			const lo = -6, hi = 3, px = (x: number) => L + ((Math.log10(Math.max(x, 1e-6)) - lo) / (hi - lo)) * (R - L);
			svg.replaceChildren();
			el('line', { x1: L, y1: Y, x2: R, y2: Y, class: 's-fg w2' });
			for (let e = lo; e <= hi; e++) el('text', { x: px(10 ** e), y: Y + 40, class: 't-mid t-sm f-muted' }, e === 0 ? '1' : `10${e < 0 ? '⁻' : ''}${'⁰¹²³⁴⁵⁶⁷⁸⁹'[Math.abs(e)]}`);
			[[g0, '1 g', true], [1.5 * g0, '1.5 g', false]].forEach(([v, s, up]) => {
				el('line', { x1: px(v as number), y1: Y - 10, x2: px(v as number), y2: Y + 10, class: 's-sky w2' });
				el('text', { x: px(v as number), y: up ? Y - 16 : Y + 24, class: `${up ? 't-end' : ''} t-sm f-sky` }, s as string);
			});
			el('rect', { x: L, y: Y - 6, width: Math.max(2, px(a) - L), height: 12, class: 'f-amber' });
			el('text', { x: (L + R) / 2, y: Y + 62, class: 't-mid t-sm' }, 'ship’s acceleration (m/s², logarithmic)');
			out.innerHTML =
				`<span class="k">thrust F = ṁ v<sub>e</sub></span> = <b>${sci(F)} N</b> &nbsp; <span class="k">acceleration F/m</span> = <b>${sci(a)} m/s²</b> = ${sci(a / g0)} g` +
				` &nbsp; ${a > g0 ? 'enough to lift off Earth' : 'too weak to lift off Earth'}<br>` +
				`<span class="k">exhaust power</span> ${light ? 'Fc' : '½Fv<sub>e</sub>'} = <b>${sci(P)} W</b>, which is ${sci(P / F)} W for every newton of thrust`;
		}
		[Es, Ms, Ss].forEach((i) => i.addEventListener('input', draw));
		draw();
	});
</script>
