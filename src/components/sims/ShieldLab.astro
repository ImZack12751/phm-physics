---
// Simulation: shielding. 60 particles fired at a slab of water or lead of chosen thickness (log slider, 1 µm to 1 m).
// Gamma rays (0.1, 0.5, 1, 2 MeV; NIST μ/ρ for lead and water): each photon's interaction depth is −ln(u)/μ, so the
// transmitted fraction is e^(−μx); the readout gives the exact fraction, μ, half-value layer and mass per area.
// Alpha (5 MeV) and beta (0.5 MeV): approximate ranges as mass per area (alpha 0.004 g/cm² of water = 40 µm of skin;
// beta 0.15 g/cm², consistent with about 1 m of air), scaled for lead by the ratio of minimum stopping powers
// (water 1.981 / lead 1.122 MeV cm²/g, PDG). Charged particles all stop at about their range. Static: redraws on input.
---

<div
	class="sim shl"
	data-title="Shielding lab"
	data-description="Fire 60 particles at a slab of water or lead. Choose the radiation (5 MeV alpha particles, 0.5 MeV beta particles, or gamma rays of 0.1, 0.5, 1 or 2 MeV) and the slab thickness on a logarithmic scale from 1 micrometre to 1 metre. Gamma photons are removed at random depths, so the fraction getting through falls exponentially, I/I₀ = e to the power −μx, using NIST mass attenuation coefficients. Alpha and beta particles have a fairly definite range (approximate values, about 40 µm and 1.5 mm of water) and all stop if the slab is thicker. The readout gives the fraction transmitted, the attenuation coefficient, the half-value layer and the slab's mass per area in g/cm²."
>
	<p class="sim-title">Simulation: shielding lab</p>
	<p class="sim-help">Charged particles slow down and stop. Photons travel until, by chance, they are absorbed or scattered.</p>
	<div class="sim-controls">
		<label>Radiation <select class="shl-r">
			<option value="a">alpha, 5 MeV</option>
			<option value="b">beta, 0.5 MeV</option>
			<option value="0.1">gamma / X-ray, 0.1 MeV</option>
			<option value="0.5">gamma, 0.5 MeV</option>
			<option value="1" selected>gamma, 1 MeV</option>
			<option value="2">gamma, 2 MeV</option>
		</select></label>
		<label>Material <select class="shl-m">
			<option value="pb">lead (11.35 g/cm³)</option>
			<option value="w">water (1.00 g/cm³)</option>
		</select></label>
		<label>Thickness <input type="range" class="shl-x" min="-4" max="2" step="0.01" value="0.7" /> <output class="shl-xv"></output></label>
		<button type="button" class="shl-fire">Fire again</button>
	</div>
	<svg class="dg shl-svg" viewBox="0 0 600 260" role="img" aria-label="Particles entering a slab from the left; those that get through continue to the right"></svg>
	<div class="readout shl-out" aria-live="polite"></div>
</div>

<script>
	/** x.toExponential(d) written properly: 1.96e+10 → "1.96 × 10¹⁰" (Unicode superscripts, fine in SVG and HTML). */
	const pow10 = (x: number, d: number) => {
		const [m, e] = x.toExponential(d).split('e');
		return `${m} × 10${String(+e).replace(/-/g, '⁻').replace(/[0-9]/g, (c) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+c])}`;
	};
	document.querySelectorAll<HTMLElement>('.sim.shl').forEach((root) => {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('.shl-svg'), out = q<HTMLElement>('.shl-out');
		const Rs = q<HTMLSelectElement>('.shl-r'), Ms = q<HTMLSelectElement>('.shl-m'), Xs = q<HTMLInputElement>('.shl-x');
		const NS = 'http://www.w3.org/2000/svg';
		const el = (tag: string, at: Record<string, string | number>, text?: string) => {
			const e = document.createElementNS(NS, tag);
			Object.entries(at).forEach(([k, v]) => e.setAttribute(k, String(v)));
			if (text) e.textContent = text;
			svg.append(e);
			return e;
		};
		const muOverRho: Record<string, Record<string, number>> = {
			pb: { '0.1': 5.549, '0.5': 0.1614, '1': 0.07102, '2': 0.04606 },
			w: { '0.1': 0.1707, '0.5': 0.09687, '1': 0.07072, '2': 0.04942 },
		};
		const rho: Record<string, number> = { pb: 11.35, w: 1.0 };
		const rangeWater: Record<string, number> = { a: 0.004, b: 0.15 }; // g/cm², approximate
		const leadFactor = 1.981 / 1.122;
		const N = 60, SX = 230, SW = 140, Y0 = 30, Y1 = 230;
		const slab = el('rect', { x: SX, y: Y0 - 10, width: SW, height: Y1 - Y0 + 20, class: 'f-violet' });
		const slabLab = el('text', { x: SX + SW / 2, y: 252, class: 't-mid t-sm' });
		const lines: SVGLineElement[] = [], dots: SVGCircleElement[] = [];
		for (let i = 0; i < N; i++) {
			lines.push(el('line', { class: 's-amber w1' }) as SVGLineElement);
			dots.push(el('circle', { r: 2.5, class: 'f-rose' }) as SVGCircleElement);
		}
		el('text', { x: 10, y: 16, class: 't-sm f-muted' }, 'in →');
		const passLab = el('text', { x: 590, y: 16, class: 't-end t-sm' });
		const fmtLen = (cm: number) => (cm >= 1e5 ? `${(+(cm / 1e5).toPrecision(3)).toLocaleString('en-GB')} km` : cm >= 100 ? `${(cm / 100).toPrecision(3)} m` : cm >= 1 ? `${cm.toPrecision(3)} cm` : cm >= 0.1 ? `${(cm * 10).toPrecision(3)} mm` : `${(cm * 1e4).toPrecision(3)} µm`);
		function draw() {
			const r = Rs.value, m = Ms.value, x = 10 ** +Xs.value; // cm
			q('.shl-xv').textContent = fmtLen(x);
			slabLab.textContent = `${m === 'pb' ? 'lead' : 'water'}, ${fmtLen(x)} (drawn the same width at every thickness)`;
			slab.setAttribute('class', m === 'pb' ? 'f-violet' : 'f-sky-soft');
			const sigma = rho[m] * x; // g/cm²
			let through = 0, exact = 0, extra = '';
			if (r === 'a' || r === 'b') {
				const range = rangeWater[r] * (m === 'pb' ? leadFactor : 1) / rho[m]; // cm
				lines.forEach((ln, i) => {
					const y = Y0 + (i + 0.5) * ((Y1 - Y0) / N);
					const stop = range * (0.95 + 0.1 * Math.random());
					const passes = stop > x;
					if (passes) through++;
					const xe = passes ? 580 : SX + (stop / x) * SW;
					ln.setAttribute('x1', '20'); ln.setAttribute('y1', String(y)); ln.setAttribute('x2', String(xe)); ln.setAttribute('y2', String(y));
					ln.setAttribute('class', r === 'a' ? 's-amber w1' : 's-sky w1');
					dots[i].setAttribute('cx', String(xe)); dots[i].setAttribute('cy', String(y));
					dots[i].setAttribute('r', passes ? '0' : '2.5');
				});
				exact = range > x ? 1 : 0;
				extra = `<span class="k">approximate range</span> ${fmtLen(range)} of ${m === 'pb' ? 'lead' : 'water'} (${(range * rho[m]).toPrecision(2)} g/cm²): thinner slabs let all through, thicker ones stop all.`;
			} else {
				const mu = muOverRho[m][r] * rho[m]; // 1/cm
				exact = Math.exp(-mu * x);
				lines.forEach((ln, i) => {
					const y = Y0 + (i + 0.5) * ((Y1 - Y0) / N);
					const depth = -Math.log(1 - Math.random()) / mu;
					const passes = depth > x;
					if (passes) through++;
					const xe = passes ? 580 : SX + (depth / x) * SW;
					ln.setAttribute('x1', '20'); ln.setAttribute('y1', String(y)); ln.setAttribute('x2', String(xe)); ln.setAttribute('y2', String(y));
					ln.setAttribute('class', 's-rose w1');
					dots[i].setAttribute('cx', String(xe)); dots[i].setAttribute('cy', String(y));
					dots[i].setAttribute('r', passes ? '0' : '2.5');
				});
				extra = `<span class="k">μ</span> = ${muOverRho[m][r]} cm²/g × ${rho[m]} g/cm³ = ${mu.toPrecision(3)} per cm &nbsp; <span class="k">half-value layer</span> ${fmtLen(Math.LN2 / mu)} &nbsp; <span class="k">expected through</span> e<sup>−μx</sup> = ${exact < 1e-4 ? pow10(exact, 1) : exact.toPrecision(3)}`;
			}
			passLab.textContent = `${through} of ${N} got through`;
			out.innerHTML = `<span class="k">slab</span>: ${fmtLen(x)} × ${rho[m]} g/cm³ = ${sigma < 0.01 ? pow10(sigma, 1) : sigma >= 1000 ? Math.round(sigma).toLocaleString('en-GB') : sigma.toPrecision(3)} g/cm² &nbsp; <span class="k">this run</span>: ${through} of ${N} through<br>${extra}`;
		}
		[Rs, Ms].forEach((s) => { s.addEventListener('change', draw); s.addEventListener('input', draw); });
		Xs.addEventListener('input', draw);
		q('.shl-fire').addEventListener('click', draw);
		draw();
	});
</script>
