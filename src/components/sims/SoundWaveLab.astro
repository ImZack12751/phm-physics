---
// Simulation: a loudspeaker sends a steady note through air at 20 °C (ρv = 413 Pa·s/m, v = 343 m/s). Sliders set the
// level at 1 m, the frequency (log scale) and the listener's distance. The readout gives the level at the listener
// (inverse-square law), intensity, pressure amplitude Δp = √(2ρvI), air speed u = Δp/ρv, displacement s = u/ω and λ.
// The animation of the air parcels is slowed down and its displacement hugely exaggerated.
---

<div
	class="sim swl"
	data-title="Sound wave lab"
	data-description="A loudspeaker on the left plays a steady note into air at 20 °C. Sliders set the sound level at 1 metre (0 to 130 dB), the frequency (20 Hz to 20 kHz, on a logarithmic scale) and the listener's distance (0.5 to 20 m). An animation shows rows of air parcels bunching into compressions and spreading into rarefactions, slowed down and with the motion hugely exaggerated, and a graph of the pressure change along the way. The readout gives the level at the listener using the inverse-square law, the intensity, the pressure amplitude from I = Δp²/2ρv and its fraction of atmospheric pressure, the speed of the air u = Δp/ρv, how far the air moves, s = u/ω, compared with the size of an atom, and the wavelength λ = v/f."
>
	<p class="sim-title">Simulation: sound wave lab</p>
	<p class="sim-help">The animation is slowed down and the motion of the air exaggerated millions of times. The readout gives the real sizes.</p>
	<div class="sim-controls">
		<label>Level at 1 m <input type="range" class="swl-db" min="0" max="130" step="1" value="60" /> <output class="swl-dbv"></output></label>
		<label>Frequency f <input type="range" class="swl-f" min="1.301" max="4.301" step="0.001" value="2.643" /> <output class="swl-fv"></output></label>
		<label>Listener distance <input type="range" class="swl-r" min="0.5" max="20" step="0.5" value="1" /> <output class="swl-rv"></output></label>
	</div>
	<svg class="dg swl-svg" viewBox="0 0 600 250" role="img" aria-label="Air parcels moving back and forth in front of a loudspeaker, with a graph of the pressure change"></svg>
	<div class="readout swl-out" aria-live="polite"></div>
</div>

<script>
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	document.querySelectorAll<HTMLElement>('.sim.swl').forEach((root) => {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('.swl-svg'), out = q<HTMLElement>('.swl-out');
		const Ds = q<HTMLInputElement>('.swl-db'), Fs = q<HTMLInputElement>('.swl-f'), Rs = q<HTMLInputElement>('.swl-r');
		const NS = 'http://www.w3.org/2000/svg';
		const el = (tag: string, at: Record<string, string | number>, text?: string) => {
			const e = document.createElementNS(NS, tag);
			Object.entries(at).forEach(([k, v]) => e.setAttribute(k, String(v)));
			if (text) e.textContent = text;
			svg.append(e);
			return e;
		};
		const Z = 413, V = 343, ATM = 101325, I0 = 1e-12;
		const X0 = 70, X1 = 580, LAMPX = 120; // drawn wavelength in px (not to scale)
		// Loudspeaker
		el('rect', { x: 18, y: 50, width: 22, height: 50, class: 'f-muted' });
		const cone = el('polygon', { class: 'f-fg' });
		// Parcels: three rows, created once
		const rows = [52, 75, 98];
		const xs: number[] = [];
		for (let x = X0; x <= X1; x += 12) xs.push(x);
		const dots = rows.map((y) => xs.map(() => el('circle', { cy: y, r: 3.5, class: 'f-amber' })));
		// Pressure graph
		const YP = 170;
		el('line', { x1: X0, y1: YP, x2: X1, y2: YP, class: 's-grid w1' });
		el('text', { x: X0, y: 132, class: 't-sm f-muted' }, 'pressure change along the wave');
		const pg = el('polyline', { class: 's-green w2', fill: 'none' });
		// Distance scale and listener
		const XR = (r: number) => X0 + (r / 20) * (X1 - X0);
		el('line', { x1: X0, y1: 220, x2: X1, y2: 220, class: 's-fg w1' });
		[0, 5, 10, 15, 20].forEach((m) => {
			el('line', { x1: XR(m), y1: 216, x2: XR(m), y2: 224, class: 's-fg w1' });
			el('text', { x: XR(m), y: 240, class: 't-mid t-sm f-muted' }, `${m} m`);
		});
		const ear = el('circle', { cy: 220, r: 7, class: 'f-sky' });
		const earT = el('text', { y: 206, class: 't-mid t-sm f-sky' }, 'listener');
		let t = 0, last = 0, ampPx = 6;
		function update() {
			const ph = 2 * Math.PI * t * 0.6; // slowed: 0.6 cycles per second on screen
			const kx = (x: number) => (2 * Math.PI * (x - X0)) / LAMPX;
			const disp = (x: number) => ampPx * Math.sin(ph - kx(x));
			dots.forEach((row) => row.forEach((d, i) => d.setAttribute('cx', (xs[i] + disp(xs[i])).toFixed(1))));
			const c = disp(X0) + 46;
			cone.setAttribute('points', `${c},40 ${c},110 40,92 40,58`);
			const pts: string[] = [];
			for (let x = X0; x <= X1; x += 4) pts.push(`${x},${(YP - ampPx * 3.2 * Math.cos(ph - kx(x))).toFixed(1)}`);
			pg.setAttribute('points', pts.join(' '));
		}
		const sci = (x: number) => {
			const e = Math.floor(Math.log10(Math.abs(x)));
			return Math.abs(e) < 3 ? x.toPrecision(Math.max(3, e + 1)) : `${(x / 10 ** e).toFixed(2)} × 10<sup>${e}</sup>`;
		};
		function draw() {
			const db1 = +Ds.value, f = 10 ** +Fs.value, r = +Rs.value;
			q('.swl-dbv').textContent = `${db1} dB`;
			q('.swl-fv').textContent = f >= 1000 ? `${(f / 1000).toFixed(2)} kHz` : `${f.toFixed(0)} Hz`;
			q('.swl-rv').textContent = `${r.toFixed(1)} m`;
			const db = db1 - 20 * Math.log10(r);
			const I = I0 * 10 ** (db / 10);
			const dp = Math.sqrt(2 * Z * I), u = dp / Z, s = u / (2 * Math.PI * f), lam = V / f;
			ampPx = Math.max(0.6, Math.min(9, 1 + (8 * Math.max(0, db)) / 130));
			ear.setAttribute('cx', String(XR(r)));
			earT.setAttribute('x', String(XR(r)));
			const atom = s / 1e-10;
			const sz = atom < 1 ? `${(atom).toFixed(2)} of an atom's width (about 10<sup>−10</sup> m)` : atom < 1e4 ? `about ${atom < 10 ? atom.toFixed(1) : Math.round(atom)} atoms' widths` : `${(s * 1e6).toPrecision(3)} µm`;
			out.innerHTML =
				`<span class="k">level at the listener</span> = ${db1} − 20 log₁₀(${r.toFixed(1)}) = <b>${db.toFixed(1)} dB</b> &nbsp; <span class="k">intensity I</span> = ${sci(I)} W/m²<br>` +
				`<span class="k">pressure amplitude Δp = √(2ρvI)</span> = <b>${sci(dp)} Pa</b>, which is ${sci(dp / ATM)} of an atmosphere<br>` +
				`<span class="k">air speed u = Δp/ρv</span> = ${sci(u)} m/s &nbsp; <span class="k">air moves s = u/ω</span> = <b>${sci(s)} m</b>, ${sz}<br>` +
				`<span class="k">wavelength λ = v/f</span> = ${lam >= 1 ? lam.toFixed(2) + ' m' : (lam * 100).toFixed(2) + ' cm'}` +
				(db < 0 ? ' &nbsp; <b>(below the threshold of hearing)</b>' : db >= 120 ? ' &nbsp; <b>(at or above the threshold of pain)</b>' : '');
			update();
		}
		function frame(now: number) {
			if (last) t += (now - last) / 1000;
			last = now;
			update();
			requestAnimationFrame(frame);
		}
		[Ds, Fs, Rs].forEach((i) => i.addEventListener('input', draw));
		draw();
		if (!reduce) requestAnimationFrame(frame);
	});
</script>
