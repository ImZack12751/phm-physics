---
// Simulation: relativity of simultaneity. A flash goes off in the middle of a ship of rest length L₀ = 100 m (our choice).
// Ship frame: both ends are hit at L₀/2c. Earth frame: the ship is L₀/γ long and moves at v; rear hit at (L/2)/(c + v),
// front at (L/2)/(c − v). The difference is γL₀v/c². Animated in slow motion (time scaled so a crossing takes ~2 s).
---

<div
	class="sim sim-sl"
	data-title="Simultaneity lab"
	data-description="A flash of light goes off in the middle of a 100 metre ship. A slider sets the ship's speed relative to Earth, from 0 to 0.99 times the speed of light, and a menu chooses whose point of view to show: the ship's or Earth's. In slow motion, two pulses of light run from the middle towards the two ends, and each end lights up when the pulse reaches it. In the ship's frame both ends are hit at the same moment. In Earth's frame the ship is shorter, moves to the right, and the rear end is hit before the front. The readout gives the times at which each end is hit in each frame, in nanoseconds, and the difference, which equals γL₀v/c². The animation stops if reduced motion is requested."
>
	<p class="sim-title">Simulation: simultaneity lab</p>
	<p class="sim-help">Both observers agree that light moves at c. Watch how that forces them to disagree about which end is hit first.</p>
	<div class="sim-controls">
		<label>Ship's speed v/c <input type="range" class="sm-b" min="0" max="0.99" step="0.01" value="0.6" /> <output class="sm-bv"></output></label>
		<label>Point of view <select class="sm-f">
			<option value="earth">Earth</option>
			<option value="ship">ship</option>
		</select></label>
	</div>
	<svg class="dg sm-svg" viewBox="0 0 600 170" role="img" aria-label="A ship with light pulses travelling from its middle to its ends"></svg>
	<div class="readout sm-out" aria-live="polite"></div>
</div>

<script>
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const C = 299792458, L0 = 100;
	document.querySelectorAll<HTMLElement>('.sim.sim-sl').forEach((root) => {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('.sm-svg'), out = q<HTMLElement>('.sm-out');
		const Bs = q<HTMLInputElement>('.sm-b'), Fs = q<HTMLSelectElement>('.sm-f');
		const NS = 'http://www.w3.org/2000/svg';
		const el = (tag: string, at: Record<string, string | number>, text?: string) => {
			const e = document.createElementNS(NS, tag);
			Object.entries(at).forEach(([k, v]) => e.setAttribute(k, String(v)));
			if (text) e.textContent = text;
			svg.append(e);
			return e;
		};
		const Y = 60, H = 40;
		const mark = el('line', { y1: 40, y2: 120, class: 's-muted w1 dash' });
		const markT = el('text', { y: 140, class: 't-mid t-sm f-muted' }, 'where the flash went off');
		const ship = el('rect', { y: Y, height: H, class: 's-sky w2', fill: 'none' });
		const rearE = el('rect', { y: Y, width: 8, height: H, class: 'f-sky' });
		const frontE = el('rect', { y: Y, width: 8, height: H, class: 'f-sky' });
		const pr = el('circle', { cy: Y + H / 2, r: 6, class: 'f-amber' });
		const pf = el('circle', { cy: Y + H / 2, r: 6, class: 'f-amber' });
		const lab = el('text', { x: 20, y: 30, class: 't-sm t-b' });
		const tlab = el('text', { x: 580, y: 162, class: 't-end t-sm f-muted' });
		let phase = 0, last = 0;
		function params() {
			const b = +Bs.value, g = 1 / Math.sqrt(1 - b * b), earth = Fs.value === 'earth';
			const L = earth ? L0 / g : L0, v = earth ? b * C : 0;
			const tr = L / 2 / (C + v), tf = L / 2 / (C - v);
			return { b, g, earth, L, v, tr, tf };
		}
		function place() {
			const s = params(), tEnd = s.tf * 1.15, t = phase * tEnd;
			// scale so the whole motion fits: from the rear's start to the front's position at tEnd
			const W = s.L + s.v * tEnd, PX = Math.min(4, 520 / W), MID = 40 + (s.L / 2) * PX;
			mark.setAttribute('x1', String(MID)); mark.setAttribute('x2', String(MID)); markT.setAttribute('x', String(Math.max(90, MID)));
			const xc = MID + s.v * t * PX; // ship centre moves
			const x0 = xc - (s.L / 2) * PX;
			ship.setAttribute('x', String(x0)); ship.setAttribute('width', String(s.L * PX));
			const hitR = t >= s.tr, hitF = t >= s.tf;
			rearE.setAttribute('x', String(x0)); rearE.setAttribute('class', hitR ? 'f-green' : 'f-sky');
			frontE.setAttribute('x', String(x0 + s.L * PX - 8)); frontE.setAttribute('class', hitF ? 'f-green' : 'f-sky');
			pr.setAttribute('cx', String(Math.max(x0 + 4, MID - C * t * PX))); pr.setAttribute('opacity', hitR ? '0' : '1');
			pf.setAttribute('cx', String(Math.min(x0 + s.L * PX - 4, MID + C * t * PX))); pf.setAttribute('opacity', hitF ? '0' : '1');
			tlab.textContent = `time since the flash: ${(t * 1e9).toFixed(0)} ns (slow motion)`;
		}
		function draw() {
			const s = params();
			q('.sm-bv').textContent = s.b.toFixed(2);
			lab.textContent = s.earth ? `Earth's view: ship ${s.L.toFixed(1)} m long, moving right at ${s.b.toFixed(2)}c` : `ship's view: ship ${L0} m long, at rest`;
			const tShip = (L0 / 2 / C) * 1e9;
			const sE = (() => { const L = L0 / s.g, v = s.b * C; return { tr: L / 2 / (C + v), tf: L / 2 / (C - v) }; })();
			out.innerHTML =
				`<span class="k">ship's frame</span>: both ends hit at ${tShip.toFixed(1)} ns, together<br>` +
				`<span class="k">Earth's frame</span>: rear hit at <b>${(sE.tr * 1e9).toFixed(1)} ns</b>, front at <b>${(sE.tf * 1e9).toFixed(1)} ns</b>; ` +
				`difference ${((sE.tf - sE.tr) * 1e9).toFixed(1)} ns = γL₀v/c² = ${((s.g * L0 * s.b) / C * 1e9).toFixed(1)} ns (γ = ${s.g.toFixed(3)})`;
			place();
		}
		function frame(now: number) {
			if (last) phase += (now - last) / 2400;
			last = now;
			if (phase > 1.3) phase = 0;
			const keep = phase;
			phase = Math.min(1, phase);
			place();
			phase = keep;
			requestAnimationFrame(frame);
		}
		Bs.addEventListener('input', draw);
		Fs.addEventListener('change', draw);
		Fs.addEventListener('input', draw);
		draw();
		if (reduce) { phase = 0.6; place(); } else requestAnimationFrame(frame);
	});
</script>
