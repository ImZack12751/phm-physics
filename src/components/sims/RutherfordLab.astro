---
// Simulation: Rutherford scattering. Alpha particles (charge 2e) with kinetic energy K approach a nucleus of charge Ze
// with impact parameters spread evenly across the view. Trajectories are integrated numerically with Coulomb repulsion
// (k q1 q2 / m = d v0²/2, d = 2Zke²/K the head-on turning distance). "Plum pudding" spreads gold's charge uniformly over
// a sphere of the atom's size (0.14 nm), so the force inside is tiny and paths stay straight. Readout: d, the nucleus's
// radius 1.2 fm × A^(1/3), the impact parameter for a 90° bounce (d/2, from tan(θ/2) = d/2b), and the share of an atom's
// area (radius 0.14 nm, assumed) that turns alphas back. Static: redraws on input only.
---

<div
	class="sim rfl"
	data-title="Rutherford scattering lab"
	data-description="Fire alpha particles at an atomic nucleus. Choose the target (gold Z = 79, silver Z = 47, aluminium Z = 13, or Thomson's 'plum pudding' gold atom with its positive charge spread over the whole atom) and the alpha particles' kinetic energy (1 to 10 MeV). Thirty-one trajectories with evenly spaced aiming distances are drawn on a scale of femtometres; those turned through more than 90 degrees are red, more than 10 degrees blue. The readout gives the head-on turning distance d = 2Zke²/K, the nucleus's radius 1.2 fm × A^(1/3), the aiming distance for a 90° bounce (d/2), and the fraction of an atom's cross-section (radius taken as 0.14 nm) that bounces alphas back. In the plum-pudding model no alpha is deflected by more than a few hundredths of a degree."
>
	<p class="sim-title">Simulation: Rutherford scattering</p>
	<p class="sim-help">Each line is one alpha particle, coming in from the left. Only those aimed almost straight at the nucleus come back.</p>
	<div class="sim-controls">
		<label>Target <select class="rfl-t">
			<option value="au">gold nucleus (Z = 79)</option>
			<option value="ag">silver nucleus (Z = 47)</option>
			<option value="al">aluminium nucleus (Z = 13)</option>
			<option value="pud">plum-pudding gold atom</option>
		</select></label>
		<label>Alpha energy <input type="range" class="rfl-k" min="1" max="10" step="0.1" value="5" /> <output class="rfl-kv"></output></label>
	</div>
	<svg class="dg rfl-svg" viewBox="0 0 600 330" role="img" aria-label="Alpha particle trajectories bending around a nucleus at the centre"></svg>
	<div class="readout rfl-out" aria-live="polite"></div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('.sim.rfl').forEach((root) => {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('.rfl-svg'), out = q<HTMLElement>('.rfl-out');
		const Ts = q<HTMLSelectElement>('.rfl-t'), Ks = q<HTMLInputElement>('.rfl-k');
		const NS = 'http://www.w3.org/2000/svg';
		const el = (tag: string, at: Record<string, string | number>, text?: string) => {
			const e = document.createElementNS(NS, tag);
			Object.entries(at).forEach(([k, v]) => e.setAttribute(k, String(v)));
			if (text) e.textContent = text;
			svg.append(e);
			return e;
		};
		const targets: Record<string, { Z: number; A: number; name: string }> = {
			au: { Z: 79, A: 197, name: 'gold' },
			ag: { Z: 47, A: 108, name: 'silver' },
			al: { Z: 13, A: 27, name: 'aluminium' },
			pud: { Z: 79, A: 197, name: 'plum-pudding gold' },
		};
		const KE2 = 1.44; // MeV·fm
		const RATOM = 1.4e5; // fm (0.14 nm, assumed)
		const CX = 330, CY = 160, S = 0.55; // px per fm
		const N = 31, BMAX = 270; // fm
		const paths: SVGPathElement[] = [];
		for (let i = 0; i < N; i++) paths.push(el('path', { class: 's-amber w1', fill: 'none' }) as SVGPathElement);
		const nucleus = el('circle', { cx: CX, cy: CY, class: 'f-rose' });
		const ring = el('circle', { cx: CX, cy: CY, class: 's-rose w1 dash', fill: 'none' });
		el('text', { x: 12, y: 20, class: 't-sm f-muted' }, 'alphas in →');
		el('line', { x1: 20, y1: 314, x2: 20 + 100 * S, y2: 314, class: 's-fg w2' });
		el('text', { x: 20 + 50 * S, y: 308, class: 't-mid t-sm' }, '100 fm');
		const ringLab = el('text', { x: CX, y: CY, class: 't-sm f-rose' });
		const fmt = (x: number, p = 3) => x.toPrecision(p);
		function trace(b: number, d: number, pud: boolean) {
			// units: fm and v0 = 1; acceleration magnitude a = (d/2)/r² (nucleus) or (d/2) r/R³ (pudding, inside)
			// start far away (5000 fm) so the alpha arrives with its full energy; plot only inside the view
			let x = -5000, y = b, vx = 1, vy = 0;
			const pts: string[] = [];
			let n = 0;
			while (n++ < 40000) {
				const r2 = x * x + y * y, r = Math.sqrt(r2);
				const dt = Math.max(0.2, r * 0.004);
				const a = pud ? (r < RATOM ? (d / 2) * r / RATOM ** 3 : (d / 2) / r2) : (d / 2) / r2;
				vx += (a * x) / r * dt; vy += (a * y) / r * dt;
				x += vx * dt; y += vy * dt;
				const px = CX + x * S, py = CY - y * S;
				const inView = px > -10 && px < 610 && py > -10 && py < 340;
				if (inView && n % 3 === 0) pts.push(`${px.toFixed(1)},${py.toFixed(1)}`);
				if (!inView && x * vx > 0 && r > 400) break;
			}
			return { d: pts.length > 1 ? 'M ' + pts.join(' L ') : 'M 0 0', th: Math.atan2(vy, vx) };
		}
		function draw() {
			const t = targets[Ts.value], K = +Ks.value, pud = Ts.value === 'pud';
			q('.rfl-kv').textContent = `${K.toFixed(1)} MeV`;
			const d = (2 * t.Z * KE2) / K, Rn = 1.2 * t.A ** (1 / 3);
			let back = 0, side = 0, maxDeg = 0;
			paths.forEach((p, i) => {
				const b = -BMAX + (2 * BMAX * i) / (N - 1) + 0.37;
				const tr = trace(b, d, pud);
				const deg = Math.abs((tr.th * 180) / Math.PI);
				maxDeg = Math.max(maxDeg, deg);
				if (deg > 90) back++; else if (deg > 10) side++;
				p.setAttribute('d', tr.d);
				p.setAttribute('class', deg > 90 ? 's-rose w2' : deg > 10 ? 's-sky w1' : 's-amber w1');
			});
			nucleus.setAttribute('r', String(pud ? 0 : Math.max(2, Rn * S)));
			ring.setAttribute('r', String(pud ? 0 : d * S));
			ringLab.setAttribute('x', String(CX + d * S * 0.72 + 4));
			ringLab.setAttribute('y', String(CY - d * S * 0.72 - 4));
			ringLab.textContent = pud ? '' : 'closest head-on approach';
			const b90 = d / 2, share = (b90 / RATOM) ** 2;
			out.innerHTML = pud
				? `<span class="k">plum pudding</span>: charge +79e spread over the whole atom (radius 0.14 nm). Inside it the push is tiny, so every path is straight to within ${fmt(Math.max(maxDeg, (d / RATOM) * 57.3), 2)}°.<br>` +
					`No alpha could ever bounce back, yet Geiger and Marsden saw about 1 in 8000 do so: the charge must be concentrated in a nucleus.`
				: `<span class="k">head-on turning distance</span> d = 2Zke²/K = ${fmt(d)} fm &nbsp; <span class="k">${t.name} nucleus radius</span> ≈ ${fmt(Rn, 2)} fm ${d > Rn + 1.9 ? '(the alpha never touches it)' : '(the alpha reaches the nucleus: the strong force joins in, and the pure Coulomb picture fails)'}<br>` +
					`<span class="k">aim within</span> d/2 = ${fmt(b90)} fm of the centre to be turned back more than 90° &nbsp; <span class="k">share of one atom’s area</span> ≈ ${share.toExponential(1)}<br>` +
					`<span class="k">drawn</span>: ${back} of ${N} turned back (red), ${side} deflected more than 10° (blue). The paths shown are all aimed within ${BMAX} fm, a tiny patch at the very centre of the atom.`;
		}
		Ts.addEventListener('change', draw);
		Ts.addEventListener('input', draw);
		Ks.addEventListener('input', draw);
		draw();
	});
</script>
