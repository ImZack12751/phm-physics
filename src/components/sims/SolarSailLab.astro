---
// Simulation: sunlight's push on a sail or a grain against the Sun's gravity. Push = (1 or 2) × L A / (4π r² c);
// gravity = G M m / r²; β = push / gravity is independent of r. L = 3.828e26 W, GM = 1.32712e20 m³/s² (NASA, IAU).
---

<div
	class="sim ss"
	data-title="Solar sail lab"
	data-description="Choose a sail's area (from 10⁻¹¹ to 10⁵ square metres, on a log scale), the craft's mass (10⁻¹³ to 10⁴ kilograms, log scale), its distance from the Sun (0.2 to 5 au) and whether its surface absorbs or perfectly reflects sunlight. Presets load the IKAROS solar sail (196 m², 310 kg, treated as a mirror) and a single Astrophage cell (10 micrometres across, 5.2 × 10⁻¹³ kg, absorbing). A diagram shows the Sun's gravity pulling inwards and sunlight pushing outwards, with arrow lengths on a logarithmic scale. The readout gives the sunlight's intensity and pressure at that distance, the push in newtons, the gravity, their ratio β (the same at every distance), the acceleration the light alone would give, the speed it would add in a day, and whether the craft is blown outwards or still falls towards the Sun."
>
	<p class="sim-title">Simulation: solar sail lab</p>
	<p class="sim-help">Light's push and the Sun's gravity both weaken as 1/r². Move the distance slider and watch β stay put; change the mass per area and watch it move.</p>
	<div class="sim-controls">
		<label>Sail area (log) <input type="range" class="ss-a" min="-11" max="5" step="any" value="2.29" /> <output class="ss-av"></output></label>
		<label>Mass (log) <input type="range" class="ss-m" min="-13" max="4" step="any" value="2.49" /> <output class="ss-mv"></output></label>
		<label>Distance from the Sun <input type="range" class="ss-r" min="0.2" max="5" step="0.01" value="1" /> <output class="ss-rv"></output></label>
		<label>Surface <select class="ss-s">
			<option value="2">perfect mirror</option>
			<option value="1">black (absorbs)</option>
		</select></label>
		<span class="ss-pre">
			<button type="button" data-a="2.29226" data-m="2.49136" data-s="2">IKAROS</button>
			<button type="button" data-a="-10.10491" data-m="-12.28100" data-s="1">Astrophage cell</button>
		</span>
	</div>
	<svg class="dg ss-svg" viewBox="0 0 600 200" role="img" aria-label="The Sun, a sail, and arrows for gravity and sunlight's push"></svg>
	<div class="readout ss-out" aria-live="polite"></div>
</div>

<style>
	.ss-pre { display: inline-flex; gap: 0.4rem; flex-wrap: wrap; }
</style>

<script>
	const L = 3.828e26, GM = 1.32712440018e20, C = 299792458, AU = 149597870700;
	const sci = (x: number, d = 2) => {
		if (x === 0) return '0';
		const e = Math.floor(Math.log10(Math.abs(x))), m = x / 10 ** e;
		if (e >= -2 && e <= 3) return x.toPrecision(d + 1);
		const sup = String(e).replace(/-/g, '⁻').replace(/\d/g, (k) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+k]);
		return `${m.toFixed(d)} × 10${sup}`;
	};
	document.querySelectorAll<HTMLElement>('.sim.ss').forEach((root) => {
		const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
		const svg = q<SVGSVGElement>('.ss-svg'), out = q<HTMLElement>('.ss-out');
		const As = q<HTMLInputElement>('.ss-a'), Ms = q<HTMLInputElement>('.ss-m'), Rs = q<HTMLInputElement>('.ss-r'), Ss = q<HTMLSelectElement>('.ss-s');
		const NS = 'http://www.w3.org/2000/svg';
		const el = (tag: string, at: Record<string, string | number>, text?: string) => {
			const e = document.createElementNS(NS, tag);
			Object.entries(at).forEach(([k, v]) => e.setAttribute(k, String(v)));
			if (text) e.textContent = text;
			svg.append(e);
			return e;
		};
		const SY = 95;
		el('circle', { cx: 40, cy: SY, r: 26, class: 'f-amber' });
		el('text', { x: 40, y: SY + 46, class: 't-mid t-sm' }, 'Sun');
		const sail = el('line', { y1: SY - 30, y2: SY + 30, class: 's-sky w3' });
		const gL = el('line', { class: 's-violet w3' }), gH = el('polygon', { class: 'f-violet' });
		const pL = el('line', { class: 's-amber w3' }), pH = el('polygon', { class: 'f-amber' });
		const gT = el('text', { class: 't-end t-sm f-violet halo' }), pT = el('text', { class: 't-sm f-amber halo' });
		const verdict = el('text', { x: 300, y: 190, class: 't-mid t-sm t-b' });
		const head = (x: number, y: number, dir: number) => `${x},${y} ${x - 10 * dir},${y - 5} ${x - 10 * dir},${y + 5}`;
		function draw() {
			const A = 10 ** +As.value, m = 10 ** +Ms.value, r = +Rs.value, k = +Ss.value;
			q('.ss-av').textContent = `${sci(A)} m²`;
			q('.ss-mv').textContent = `${sci(m)} kg`;
			q('.ss-rv').textContent = `${r.toFixed(2)} au`;
			const d = r * AU, I = L / (4 * Math.PI * d * d), Pr = (k * I) / C;
			const F = Pr * A, G = (GM * m) / (d * d), beta = F / G;
			const a = F / m;
			// diagram: sail x from distance; arrows on a log scale relative to the bigger force
			const x = 90 + ((r - 0.2) / 4.8) * 380;
			sail.setAttribute('x1', String(x));
			sail.setAttribute('x2', String(x));
			const big = Math.max(F, G);
			const len = (f: number) => Math.max(6, 110 + 22 * Math.log10(f / big));
			const lg = len(G), lp = len(F);
			gL.setAttribute('x1', String(x - 4)); gL.setAttribute('x2', String(x - 4 - lg + 8)); gL.setAttribute('y1', String(SY - 12)); gL.setAttribute('y2', String(SY - 12));
			gH.setAttribute('points', head(x - 4 - lg, SY - 12, -1));
			pL.setAttribute('x1', String(x + 4)); pL.setAttribute('x2', String(x + 4 + lp - 8)); pL.setAttribute('y1', String(SY + 12)); pL.setAttribute('y2', String(SY + 12));
			pH.setAttribute('points', head(x + 4 + lp, SY + 12, 1));
			gT.setAttribute('x', String(x - 8)); gT.setAttribute('y', String(SY - 22)); gT.textContent = 'gravity';
			pT.setAttribute('x', String(x + 8)); pT.setAttribute('y', String(SY + 32)); pT.textContent = 'sunlight';
			verdict.textContent = beta > 1 ? `β = ${beta.toPrecision(3)}: blown away from the Sun` : `β = ${beta.toPrecision(3)}: still falls towards the Sun`;
			verdict.setAttribute('class', `t-mid t-sm t-b ${beta > 1 ? 'f-amber' : 'f-violet'}`);
			out.innerHTML =
				`<span class="k">sunlight intensity at ${r.toFixed(2)} au</span> = ${I.toFixed(0)} W/m² &nbsp; <span class="k">light pressure ${k === 2 ? '2I/c' : 'I/c'}</span> = ${sci(Pr)} Pa<br>` +
				`<span class="k">push</span> = <b>${sci(F)} N</b> &nbsp; <span class="k">Sun’s gravity</span> = ${sci(G)} N &nbsp; <span class="k">β = push ÷ gravity</span> = <b>${beta.toPrecision(3)}</b> (the same at any distance)<br>` +
				`<span class="k">acceleration from light alone</span> = ${sci(a)} m/s², adding ${sci(a * 86400)} m/s per day &nbsp; <span class="k">mass per area</span> = ${sci(m / A)} kg/m²`;
		}
		[As, Ms, Rs].forEach((i) => i.addEventListener('input', draw));
		Ss.addEventListener('change', draw);
		Ss.addEventListener('input', draw);
		root.querySelectorAll<HTMLButtonElement>('.ss-pre button').forEach((b) =>
			b.addEventListener('click', () => {
				As.value = b.dataset.a!;
				Ms.value = b.dataset.m!;
				Ss.value = b.dataset.s!;
				Rs.value = '1';
				draw();
			}),
		);
		draw();
	});
</script>
