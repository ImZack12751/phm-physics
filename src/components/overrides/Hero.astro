---
// Home-page hero: mission briefing copy plus an animated illustration of the Hail Mary on its
// way from Sol (with the Petrova line to Venus) to Tau Ceti.
import { parts, chapters, publishedChapters } from '../../data/curriculum.mjs';
import { url, chapterUrl } from '../../lib/urls.mjs';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};
const first = publishedChapters[0];
const stats = [
	{ n: parts.length, l: 'Parts' },
	{ n: chapters.length, l: 'Chapters' },
	{ n: publishedChapters.length, l: 'Live now' },
	{ n: 'Free', l: 'Forever' },
];
const SUN = { x: 112, y: 352 };
const TAU = { x: 528, y: 92 };
// The route is one cubic Bézier curve. The ship sits on it at parameter SHIP_T, pointing along its tangent.
const R0 = { x: SUN.x + 46, y: SUN.y - 22 }, R1 = { x: 250, y: 270 }, R2 = { x: 390, y: 180 }, R3 = { x: TAU.x - 24, y: TAU.y + 12 };
const route = `M ${R0.x},${R0.y} C ${R1.x},${R1.y} ${R2.x},${R2.y} ${R3.x},${R3.y}`;
const bez = (t: number, k: 'x' | 'y') => (1 - t) ** 3 * R0[k] + 3 * (1 - t) ** 2 * t * R1[k] + 3 * (1 - t) * t * t * R2[k] + t ** 3 * R3[k];
const dbez = (t: number, k: 'x' | 'y') => 3 * (1 - t) ** 2 * (R1[k] - R0[k]) + 6 * (1 - t) * t * (R2[k] - R1[k]) + 3 * t * t * (R3[k] - R2[k]);
const SHIP_T = 0.5;
const SHIP = { x: bez(SHIP_T, 'x'), y: bez(SHIP_T, 'y'), angle: (Math.atan2(dbez(SHIP_T, 'y'), dbez(SHIP_T, 'x')) * 180) / Math.PI };
// The hull runs from x = −64 (engine) to x = 120 (nose); its middle, x = 28, goes on the route.
const SHIP_MID = 28;
const motes = [
	[78, 322], [64, 312], [90, 333], [55, 305], [71, 318], [96, 338], [47, 300],
];
---

<div class="space-hero">
	<div class="space-hero-copy">
		<p class="space-hero-kicker">Mission briefing · Project Hail Mary</p>
		<h1 id="_top" class="space-hero-title">{title}</h1>
		<p class="space-hero-sub">Learn physics. Save the Sun.</p>
		{tagline && <p class="space-hero-tagline" set:html={tagline} />}
		<div class="space-hero-actions">
			<a class="btn-primary" href={url('start-here/')}>Begin mission <span aria-hidden="true">→</span></a>
			{first && <a class="btn-ghost" href={chapterUrl(first)}>Chapter {first.number}</a>}
		</div>
		<ul class="space-hero-stats">
			{stats.map((s) => (
				<li>
					<b>{s.n}</b>
					<span>{s.l}</span>
				</li>
			))}
		</ul>
	</div>

	<svg class="space-hero-art" viewBox="0 0 600 460" role="img" aria-label="Illustration: the Hail Mary, its engines glowing, flies along a dashed route from the Sun to the star Tau Ceti. A glowing red Petrova line of Astrophage runs from the Sun to Venus.">
		<defs>
			<radialGradient id="hm-sun-g">
				<stop offset="0" stop-color="#fff7de" />
				<stop offset="0.35" stop-color="#ffd27a" />
				<stop offset="0.7" stop-color="#ff8a3c" stop-opacity="0.55" />
				<stop offset="1" stop-color="#ff6a2c" stop-opacity="0" />
			</radialGradient>
			<radialGradient id="hm-tau-g">
				<stop offset="0" stop-color="#ffffff" />
				<stop offset="0.3" stop-color="#ffe7b0" />
				<stop offset="1" stop-color="#ffc060" stop-opacity="0" />
			</radialGradient>
			<linearGradient id="hm-plume-g" x1="1" x2="0" y1="0" y2="0">
				<stop offset="0" stop-color="#fff2d8" />
				<stop offset="0.25" stop-color="#ff9d5c" />
				<stop offset="0.7" stop-color="#ff4d3a" stop-opacity="0.45" />
				<stop offset="1" stop-color="#ff3a2a" stop-opacity="0" />
			</linearGradient>
			<radialGradient id="hm-mote">
				<stop offset="0" stop-color="#ffc0a0" />
				<stop offset="1" stop-color="#ff5a3c" stop-opacity="0" />
			</radialGradient>
		</defs>

		{/* HUD frame */}
		<path d="M 8,40 L 8,8 L 40,8 M 560,8 L 592,8 L 592,40 M 592,420 L 592,452 L 560,452 M 40,452 L 8,452 L 8,420" class="hm-hud" />
		<text x="22" y="30" class="hm-label teal">NAV // ROUTE TO TAU CETI</text>
		<circle cx="20" cy="440" r="3.5" fill="#ff5a3c" class="hm-blink" />
		<text x="30" y="444" class="hm-label dim">ASTROPHAGE DETECTED</text>

		{/* inner solar system */}
		<ellipse cx={SUN.x} cy={SUN.y} rx="74" ry="28" transform={`rotate(-14 ${SUN.x} ${SUN.y})`} class="hm-orbit" />
		<ellipse cx={SUN.x} cy={SUN.y} rx="122" ry="46" transform={`rotate(-14 ${SUN.x} ${SUN.y})`} class="hm-orbit" />
		<circle cx={SUN.x} cy={SUN.y} r="70" fill="url(#hm-sun-g)" class="hm-sun" />
		<circle cx={SUN.x} cy={SUN.y} r="15" fill="#fff4d6" />
		<line x1={SUN.x - 14} y1={SUN.y - 8} x2="44" y2="298" class="hm-petrova" />
		<circle cx="42" cy="297" r="6" fill="#e9d6b0" />
		{motes.map(([x, y]) => <circle cx={x} cy={y} r="5" fill="url(#hm-mote)" />)}
		<text x={SUN.x - 6} y={SUN.y + 50} class="hm-label gold">SOL</text>
		<text x="22" y="282" class="hm-label dim">VENUS</text>
		<text x="96" y="400" class="hm-label dim">PETROVA LINE</text>

		{/* route and Tau Ceti */}
		<path d={route} class="hm-route" />
		<circle cx={TAU.x} cy={TAU.y} r="46" fill="url(#hm-tau-g)" class="hm-sun" />
		<path d={`M ${TAU.x - 40},${TAU.y} L ${TAU.x + 40},${TAU.y} M ${TAU.x},${TAU.y - 40} L ${TAU.x},${TAU.y + 40}`} stroke="#ffe7b0" stroke-width="1" opacity="0.6" />
		<circle cx={TAU.x} cy={TAU.y} r="17" class="hm-hud" stroke-dasharray="3 3" />
		<text x={TAU.x - 64} y={TAU.y + 62} class="hm-label gold">TAU CETI</text>
		<text x={TAU.x - 64} y={TAU.y + 77} class="hm-label dim">11.9 LIGHT-YEARS</text>

		{/* the Hail Mary */}
		<g transform={`translate(${SHIP.x.toFixed(1)} ${SHIP.y.toFixed(1)}) rotate(${SHIP.angle.toFixed(1)}) translate(${-SHIP_MID} 0)`}>
			<g class="hm-ship">
				<path d="M -64,0 L -190,-18 Q -214,0 -190,18 Z" fill="url(#hm-plume-g)" class="hm-plume" />
				<path d="M -64,0 L -128,-7 Q -138,0 -128,7 Z" fill="#fff4e0" opacity="0.85" class="hm-plume" />
				<path d="M -64,-11 L -50,-17 L -50,17 L -64,11 Z" fill="#4b5578" stroke="#c3cff0" stroke-width="1" />
				<rect x="-50" y="-15" width="46" height="30" rx="3" fill="#2c3558" stroke="#9fb2dc" stroke-width="1" />
				<path d="M -38,-15 L -38,15 M -26,-15 L -26,15 M -14,-15 L -14,15" stroke="#6f80aa" stroke-width="0.8" />
				<rect x="-4" y="-4" width="62" height="8" fill="#3a4470" stroke="#9fb2dc" stroke-width="0.8" />
				<path d="M 2,-4 L 12,4 L 22,-4 L 32,4 L 42,-4 L 52,4" stroke="#7d8fbd" stroke-width="0.7" fill="none" />
				<rect x="8" y="-28" width="38" height="11" rx="1" fill="#1d2a52" stroke="#4fd1c5" stroke-width="0.9" />
				<rect x="8" y="17" width="38" height="11" rx="1" fill="#1d2a52" stroke="#4fd1c5" stroke-width="0.9" />
				<path d="M 58,-13 L 96,-13 Q 120,0 96,13 L 58,13 Z" fill="#38446e" stroke="#d0dbf5" stroke-width="1" />
				<circle cx="74" cy="-4" r="2" fill="#ffd27a" />
				<circle cx="84" cy="-4" r="2" fill="#ffd27a" />
				<circle cx="94" cy="-3" r="1.6" fill="#ffd27a" />
			</g>
		</g>
		<text x={SHIP.x - 10} y={SHIP.y + 64} class="hm-label">HAIL MARY</text>
		<text x={SHIP.x - 10} y={SHIP.y + 79} class="hm-label dim">ACCEL 1.5 g</text>
	</svg>
</div>

<script>
	if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelector<SVGSVGElement>('.space-hero-art')?.pauseAnimations();
	}
</script>
