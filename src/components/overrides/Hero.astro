---
// Home-page hero: title, tagline, actions, key figures and a navigation-chart style illustration.
import { parts, chapters, publishedChapters } from '../../data/curriculum.mjs';
import { url, chapterUrl } from '../../lib/urls.mjs';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};
const first = publishedChapters[0];
const stats = [
	{ n: parts.length, l: 'Parts' },
	{ n: chapters.length, l: 'Chapters planned' },
	{ n: publishedChapters.length, l: 'Chapters live' },
	{ n: 'Free', l: 'No account' },
];

// Chart geometry: a top-down view of the inner Solar System and the route out to Tau Ceti.
const SUN = { x: 200, y: 260 };
const orbit = (r: number) => `M${SUN.x - r},${SUN.y} a${r},${r} 0 1,0 ${2 * r},0 a${r},${r} 0 1,0 ${-2 * r},0`;
const at = (r: number, deg: number) => ({ x: SUN.x + r * Math.cos((deg * Math.PI) / 180), y: SUN.y - r * Math.sin((deg * Math.PI) / 180) });
const venus = at(58, 205);
const start = at(84, 40);
const TAU = { x: 458, y: 74 };
const RING = 168;
const ticks = Array.from({ length: 72 }, (_, i) => i * 5).map((d) => {
	const len = d % 30 === 0 ? 9 : 4;
	const a = at(RING, d), b = at(RING + len, d);
	return `M${a.x.toFixed(1)},${a.y.toFixed(1)} L${b.x.toFixed(1)},${b.y.toFixed(1)}`;
});
---

<div class="space-hero">
	<div class="space-hero-copy">
		<p class="space-hero-kicker">A course in physics, from first principles</p>
		<h1 id="_top" class="space-hero-title">{title}</h1>
		{tagline && <p class="space-hero-tagline" set:html={tagline} />}
		<div class="space-hero-actions">
			<a class="btn-primary" href={url('start-here/')}>Begin the course <span aria-hidden="true">→</span></a>
			{first && <a class="btn-ghost" href={chapterUrl(first)}>Chapter {first.number}: {first.title}</a>}
		</div>
		<ul class="space-hero-stats">
			{stats.map((s) => (
				<li>
					<b>{s.n}</b>
					<span>{s.l}</span>
				</li>
			))}
		</ul>
	</div>

	<svg class="space-hero-art" viewBox="0 0 520 450" role="img" aria-label="Navigation-chart illustration: the Sun with the orbits of Venus, Earth and Mars, a red line of Astrophage from the Sun to Venus, and a dashed route from Earth's orbit out to Tau Ceti, 11.9 light-years away, with a ship travelling along it. Not to scale.">
		<defs>
			<radialGradient id="hero-glow">
				<stop offset="0" stop-color="#f3d9a0" stop-opacity="0.55" />
				<stop offset="1" stop-color="#f3d9a0" stop-opacity="0" />
			</radialGradient>
			<path id="hero-earth" d={orbit(84)} />
			<path id="hero-route" d={`M${start.x.toFixed(1)},${start.y.toFixed(1)} C 322,150 380,98 ${TAU.x - 9},${TAU.y + 4}`} />
		</defs>

		{/* faint chart grid */}
		{Array.from({ length: 14 }, (_, i) => <line x1={i * 40} y1="0" x2={i * 40} y2="450" class="chart-grid" />)}
		{Array.from({ length: 12 }, (_, i) => <line x1="0" y1={i * 40} x2="520" y2={i * 40} class="chart-grid" />)}

		{/* orbits and the bearing ring */}
		<path d={orbit(58)} class="chart-orbit" />
		<path d={orbit(84)} class="chart-orbit" />
		<path d={orbit(126)} class="chart-orbit faint" />
		<path d={ticks.join(' ')} class="chart-ticks" />

		{/* the Sun */}
		<circle cx={SUN.x} cy={SUN.y} r="30" fill="url(#hero-glow)" class="chart-sun-glow" />
		<circle cx={SUN.x} cy={SUN.y} r="5" fill="#fff4dc" />

		{/* Petrova line to Venus */}
		<line x1={SUN.x - 5} y1={SUN.y + 2} x2={venus.x.toFixed(1)} y2={venus.y.toFixed(1)} class="chart-petrova" />
		<circle cx={venus.x.toFixed(1)} cy={venus.y.toFixed(1)} r="3" fill="#e9dcc0" />

		{/* Earth, slowly orbiting */}
		<circle r="3.5" fill="#9cc8ea">
			<animateMotion dur="40s" repeatCount="indefinite"><mpath href="#hero-earth" /></animateMotion>
		</circle>

		{/* route to Tau Ceti and the ship */}
		<use href="#hero-route" class="chart-route" />
		<g class="chart-cross">
			<circle cx={TAU.x} cy={TAU.y} r="9" />
			<line x1={TAU.x - 16} y1={TAU.y} x2={TAU.x - 11} y2={TAU.y} />
			<line x1={TAU.x + 11} y1={TAU.y} x2={TAU.x + 16} y2={TAU.y} />
			<line x1={TAU.x} y1={TAU.y - 16} x2={TAU.x} y2={TAU.y - 11} />
			<line x1={TAU.x} y1={TAU.y + 11} x2={TAU.x} y2={TAU.y + 16} />
		</g>
		<circle cx={TAU.x} cy={TAU.y} r="2.6" fill="#fbecc6" />
		<g>
			<animateMotion dur="14s" repeatCount="indefinite" rotate="auto" calcMode="spline" keyTimes="0;1" keyPoints="0;1" keySplines="0.4 0 0.6 1"><mpath href="#hero-route" /></animateMotion>
			<animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.1;0.88;1" dur="14s" repeatCount="indefinite" />
			<path d="M 6,0 L -4,-3.2 L -2,0 L -4,3.2 Z" class="chart-ship" />
		</g>

		<text x={SUN.x + 12} y={SUN.y + 18} class="chart-label">SOL</text>
		<text x={TAU.x - 20} y={TAU.y + 34} class="chart-label" text-anchor="middle">TAU CETI</text>
		<text x={TAU.x - 20} y={TAU.y + 48} class="chart-label dim" text-anchor="middle">11.9 LY</text>
		<text x="14" y="20" class="chart-label dim">FIG. 1   ROUTE TO TAU CETI   NOT TO SCALE</text>
	</svg>
</div>

<script>
	// Honour "reduce motion": freeze the SVG animations.
	if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
		document.querySelector<SVGSVGElement>('.space-hero-art')?.pauseAnimations();
	}
</script>
