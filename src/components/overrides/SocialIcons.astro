---
// Header controls: collapse the navigation sidebar, collapse "On this page", or focus mode
// (both at once). Followed by Starlight's own social links. Desktop only (the header's right
// group is hidden on phones, where both sidebars are already menus).
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<div class="layout-controls" role="group" aria-label="Page layout">
	<button type="button" class="layout-btn" data-toggle="nav" aria-pressed="false" aria-label="Hide navigation sidebar" title="Hide navigation  [">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16" /><path d="M6 9h1M6 12h1M6 15h1" /></svg>
	</button>
	<button type="button" class="layout-btn" data-toggle="toc" aria-pressed="false" aria-label="Hide page contents" title="Hide page contents  ]">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M15 4v16" /><path d="M17.5 9h1M17.5 12h1M17.5 15h1" /></svg>
	</button>
	<button type="button" class="layout-btn" data-toggle="focus" aria-pressed="false" aria-label="Focus mode: hide both sidebars" title="Focus mode  \">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 9V5h4M20 9V5h-4M4 15v4h4M20 15v4h-4" /><path d="M9 10h6M9 14h6" /></svg>
	</button>
</div>
<Default />

<script>
	import '../../scripts/layout';
</script>
