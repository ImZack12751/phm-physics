---
// Animated deep-space backdrop (dark theme only):
//  - coloured nebulae (CSS), three parallax layers of twinkling stars,
//  - a few bright stars with diffraction spikes, and Tau Ceti glowing in the corner,
//  - the Petrova line: a faint infrared streak with Astrophage drifting along it,
//  - the occasional shooting star.
// Static when the reader prefers reduced motion; paused when the tab is hidden; never printed.
---

<div class="space-bg" aria-hidden="true">
	<div class="nebula nebula-a"></div>
	<div class="nebula nebula-b"></div>
	<div class="nebula nebula-c"></div>
	<div class="nebula nebula-d"></div>
	<canvas class="starfield"></canvas>
	<div class="space-vignette"></div>
</div>
<div class="reading-progress" aria-hidden="true"><div class="reading-progress-bar"></div></div>

<script>
	const canvas = document.querySelector<HTMLCanvasElement>('canvas.starfield');
	const bar = document.querySelector<HTMLElement>('.reading-progress-bar');

	if (bar) {
		const onScroll = () => {
			const max = document.documentElement.scrollHeight - innerHeight;
			bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
		};
		addEventListener('scroll', onScroll, { passive: true });
		addEventListener('resize', onScroll);
		onScroll();
	}

	if (canvas) {
		const ctx = canvas.getContext('2d')!;
		const reduce = matchMedia('(prefers-reduced-motion: reduce)');
		type Star = { x: number; y: number; r: number; a: number; tw: number; ph: number; hue: number };
		type Mote = { s: number; off: number; v: number; r: number; ph: number };
		const LAYERS = [
			{ density: 11, r: [0.3, 0.75], a: 0.5, par: 0.02 },
			{ density: 4, r: [0.6, 1.2], a: 0.7, par: 0.05 },
			{ density: 1, r: [1.1, 1.8], a: 0.9, par: 0.1 },
		];
		let layers: Star[][] = [];
		let bright: Star[] = [];
		let motes: Mote[] = [];
		let w = 0, h = 0, raf = 0, last = 0;
		let shooter: { x: number; y: number; vx: number; vy: number; life: number } | null = null;
		let nextShooter = performance.now() + 5000 + Math.random() * 7000;
		const isDark = () => document.documentElement.dataset.theme !== 'light';

		// The Petrova line runs diagonally across the sky, from lower left to upper right.
		const line = () => ({ x0: -0.1 * w, y0: 0.92 * h, x1: 1.1 * w, y1: 0.18 * h });

		function seed() {
			const dpr = Math.min(2, devicePixelRatio || 1);
			w = innerWidth;
			h = innerHeight;
			canvas!.width = w * dpr;
			canvas!.height = h * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			const star = (L: (typeof LAYERS)[number]): Star => ({
				x: Math.random() * w,
				y: Math.random() * h,
				r: L.r[0] + Math.random() * (L.r[1] - L.r[0]),
				a: L.a * (0.6 + Math.random() * 0.4),
				tw: 0.4 + Math.random() * 1.6,
				ph: Math.random() * Math.PI * 2,
				hue: Math.random() < 0.18 ? 36 : Math.random() < 0.35 ? 210 : 0,
			});
			layers = LAYERS.map((L) => Array.from({ length: Math.round((w * h * L.density) / 100000) }, () => star(L)));
			bright = Array.from({ length: Math.max(3, Math.round((w * h) / 260000)) }, () => ({ ...star(LAYERS[2]), r: 1.6 + Math.random() * 0.8, a: 1 }));
			motes = Array.from({ length: Math.round(w / 18) }, () => ({
				s: Math.random(),
				off: (Math.random() - 0.5) * 70,
				v: 0.000012 + Math.random() * 0.00002,
				r: 0.6 + Math.random() * 1.3,
				ph: Math.random() * Math.PI * 2,
			}));
		}

		const glow = (x: number, y: number, r: number, color: string, alpha: number) => {
			const g = ctx.createRadialGradient(x, y, 0, x, y, r);
			g.addColorStop(0, color.replace('A', String(alpha)));
			g.addColorStop(1, color.replace('A', '0'));
			ctx.fillStyle = g;
			ctx.beginPath();
			ctx.arc(x, y, r, 0, Math.PI * 2);
			ctx.fill();
		};

		function draw(t: number) {
			ctx.clearRect(0, 0, w, h);
			const sy = scrollY;
			const still = reduce.matches;

			// Petrova line: a soft infrared band
			const L = line();
			const shift = -(sy * 0.04) % h;
			ctx.save();
			ctx.translate(0, shift);
			const band = ctx.createLinearGradient(L.x0, L.y0, L.x1, L.y1);
			band.addColorStop(0, 'rgba(255,90,60,0)');
			band.addColorStop(0.35, 'rgba(255,90,60,0.09)');
			band.addColorStop(0.7, 'rgba(255,120,70,0.06)');
			band.addColorStop(1, 'rgba(255,90,60,0)');
			ctx.strokeStyle = band;
			ctx.lineCap = 'round';
			for (const [lw, a] of [[90, 0.35], [36, 0.6], [6, 1]] as const) {
				ctx.globalAlpha = a;
				ctx.lineWidth = lw;
				ctx.beginPath();
				ctx.moveTo(L.x0, L.y0);
				ctx.lineTo(L.x1, L.y1);
				ctx.stroke();
			}
			ctx.globalAlpha = 1;
			// Astrophage drifting along it
			const len = Math.hypot(L.x1 - L.x0, L.y1 - L.y0);
			const nx = -(L.y1 - L.y0) / len, ny = (L.x1 - L.x0) / len;
			for (const m of motes) {
				if (!still) m.s = (m.s + m.v * 16) % 1;
				const wob = Math.sin(t * 0.0008 + m.ph) * 6;
				const x = L.x0 + (L.x1 - L.x0) * m.s + nx * (m.off + wob);
				const y = L.y0 + (L.y1 - L.y0) * m.s + ny * (m.off + wob);
				const pulse = still ? 1 : 0.7 + 0.3 * Math.sin(t * 0.003 + m.ph);
				glow(x, y, m.r * 5, 'rgba(255,95,60,A)', 0.35 * pulse);
				ctx.fillStyle = `rgba(255,170,130,${0.85 * pulse})`;
				ctx.beginPath();
				ctx.arc(x, y, m.r * 0.8, 0, Math.PI * 2);
				ctx.fill();
			}
			ctx.restore();

			// Stars
			layers.forEach((stars, li) => {
				const par = LAYERS[li].par;
				for (const s of stars) {
					const y = (((s.y - sy * par) % h) + h) % h;
					const twinkle = still ? 1 : 0.6 + 0.4 * Math.sin(t * 0.001 * s.tw + s.ph);
					ctx.globalAlpha = s.a * twinkle;
					ctx.fillStyle = s.hue ? `hsl(${s.hue} 80% 86%)` : '#ffffff';
					ctx.beginPath();
					ctx.arc(s.x, y, s.r, 0, Math.PI * 2);
					ctx.fill();
				}
			});
			ctx.globalAlpha = 1;

			// Bright stars with diffraction spikes
			for (const s of bright) {
				const y = (((s.y - sy * 0.12) % h) + h) % h;
				const k = still ? 1 : 0.75 + 0.25 * Math.sin(t * 0.0012 * s.tw + s.ph);
				const col = s.hue === 36 ? '255,214,150' : s.hue === 210 ? '170,210,255' : '235,242,255';
				glow(s.x, y, 10 * k, `rgba(${col},A)`, 0.45);
				ctx.strokeStyle = `rgba(${col},${0.55 * k})`;
				ctx.lineWidth = 0.8;
				const sp = 9 + 5 * k;
				ctx.beginPath();
				ctx.moveTo(s.x - sp, y);
				ctx.lineTo(s.x + sp, y);
				ctx.moveTo(s.x, y - sp);
				ctx.lineTo(s.x, y + sp);
				ctx.stroke();
				ctx.fillStyle = `rgba(${col},1)`;
				ctx.beginPath();
				ctx.arc(s.x, y, s.r, 0, Math.PI * 2);
				ctx.fill();
			}

			// Tau Ceti, glowing gold in the upper right (the home page hero draws its own)
			if (!document.documentElement.hasAttribute('data-has-hero')) {
			const tx = w * 0.86, ty = h * 0.16 - ((sy * 0.03) % h);
			const tk = still ? 1 : 0.85 + 0.15 * Math.sin(t * 0.0009);
			glow(tx, ty, 90 * tk, 'rgba(255,200,110,A)', 0.16);
			glow(tx, ty, 22 * tk, 'rgba(255,220,150,A)', 0.55);
			ctx.strokeStyle = `rgba(255,225,170,${0.5 * tk})`;
			ctx.lineWidth = 1;
			ctx.beginPath();
			ctx.moveTo(tx - 46, ty);
			ctx.lineTo(tx + 46, ty);
			ctx.moveTo(tx, ty - 46);
			ctx.lineTo(tx, ty + 46);
			ctx.stroke();
			ctx.fillStyle = '#fff6e0';
			ctx.beginPath();
			ctx.arc(tx, ty, 3.2, 0, Math.PI * 2);
			ctx.fill();
			}

			if (shooter) {
				const { x, y, vx, vy, life } = shooter;
				const g = ctx.createLinearGradient(x, y, x - vx * 22, y - vy * 22);
				g.addColorStop(0, `rgba(255,240,215,${0.95 * life})`);
				g.addColorStop(1, 'rgba(255,240,215,0)');
				ctx.strokeStyle = g;
				ctx.lineWidth = 1.6;
				ctx.beginPath();
				ctx.moveTo(x, y);
				ctx.lineTo(x - vx * 22, y - vy * 22);
				ctx.stroke();
			}
		}

		function frame(t: number) {
			raf = 0;
			if (!isDark()) return;
			const dt = Math.min(50, t - (last || t));
			last = t;
			if (!shooter && t > nextShooter) {
				const fromLeft = Math.random() < 0.5;
				shooter = {
					x: fromLeft ? Math.random() * w * 0.5 : w * (0.5 + Math.random() * 0.5),
					y: Math.random() * h * 0.4,
					vx: (fromLeft ? 1 : -1) * (0.9 + Math.random() * 0.5),
					vy: 0.35 + Math.random() * 0.25,
					life: 1,
				};
			}
			if (shooter) {
				shooter.x += shooter.vx * dt;
				shooter.y += shooter.vy * dt;
				shooter.life -= dt / 900;
				if (shooter.life <= 0) {
					shooter = null;
					nextShooter = t + 9000 + Math.random() * 12000;
				}
			}
			draw(t);
			schedule();
		}
		const schedule = () => {
			if (!raf && !document.hidden && !reduce.matches && isDark()) raf = requestAnimationFrame(frame);
		};
		const redrawStatic = () => isDark() && draw(performance.now());

		seed();
		redrawStatic();
		schedule();
		let resizeTimer: number | undefined;
		addEventListener('resize', () => {
			clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => {
				seed();
				redrawStatic();
			}, 150);
		});
		addEventListener('scroll', () => reduce.matches && requestAnimationFrame(redrawStatic), { passive: true });
		document.addEventListener('visibilitychange', schedule);
		reduce.addEventListener('change', () => (reduce.matches ? redrawStatic() : schedule()));
		new MutationObserver(() => {
			if (isDark()) {
				redrawStatic();
				schedule();
			}
		}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
	}
</script>
