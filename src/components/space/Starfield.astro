---
// Animated deep-space backdrop (dark theme only): nebula glows, three parallax layers of
// twinkling stars and the occasional shooting star. Static when the reader prefers reduced
// motion; paused when the tab is hidden; never printed.
---

<div class="space-bg" aria-hidden="true">
	<div class="nebula nebula-a"></div>
	<div class="nebula nebula-b"></div>
	<div class="nebula nebula-c"></div>
	<canvas class="starfield"></canvas>
</div>
<div class="reading-progress" aria-hidden="true"><div class="reading-progress-bar"></div></div>

<script>
	const canvas = document.querySelector<HTMLCanvasElement>('canvas.starfield');
	const bar = document.querySelector<HTMLElement>('.reading-progress-bar');

	// Reading progress along the top of the page.
	if (bar) {
		const onScroll = () => {
			const max = document.documentElement.scrollHeight - innerHeight;
			bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
		};
		addEventListener('scroll', onScroll, { passive: true });
		addEventListener('resize', onScroll);
		onScroll();
	}

	if (canvas) {
		const ctx = canvas.getContext('2d')!;
		const reduce = matchMedia('(prefers-reduced-motion: reduce)');
		type Star = { x: number; y: number; r: number; a: number; tw: number; ph: number; hue: number };
		// Three depth layers: [count per 100 000 px², radius range, alpha, parallax factor]
		const LAYERS = [
			{ density: 7, r: [0.25, 0.65], a: 0.38, par: 0.02 },
			{ density: 2.6, r: [0.5, 1.0], a: 0.55, par: 0.05 },
			{ density: 0.6, r: [0.9, 1.4], a: 0.75, par: 0.1 },
		];
		let layers: Star[][] = [];
		let w = 0, h = 0, dpr = 1, raf = 0, last = 0;
		let shooter: { x: number; y: number; vx: number; vy: number; life: number } | null = null;
		let nextShooter = performance.now() + 12000 + Math.random() * 15000;

		const isDark = () => document.documentElement.dataset.theme !== 'light';

		function seed() {
			dpr = Math.min(2, devicePixelRatio || 1);
			w = innerWidth;
			h = innerHeight;
			canvas!.width = w * dpr;
			canvas!.height = h * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			layers = LAYERS.map((L) =>
				Array.from({ length: Math.round((w * h * L.density) / 100000) }, () => ({
					x: Math.random() * w,
					y: Math.random() * h,
					r: L.r[0] + Math.random() * (L.r[1] - L.r[0]),
					a: L.a * (0.6 + Math.random() * 0.4),
					tw: 0.4 + Math.random() * 1.6,
					ph: Math.random() * Math.PI * 2,
					// mostly white, a few warm and cool stars
					hue: Math.random() < 0.08 ? 38 : Math.random() < 0.2 ? 212 : 0,
				}))
			);
		}

		function draw(t: number) {
			ctx.clearRect(0, 0, w, h);
			const sy = scrollY;
			layers.forEach((stars, li) => {
				const par = LAYERS[li].par;
				for (const s of stars) {
					const y = (((s.y - sy * par) % h) + h) % h;
					const twinkle = reduce.matches ? 1 : 0.78 + 0.22 * Math.sin(t * 0.0006 * s.tw + s.ph);
					ctx.globalAlpha = s.a * twinkle;
					ctx.fillStyle = s.hue ? `hsl(${s.hue} 45% 88%)` : '#ffffff';
					ctx.beginPath();
					ctx.arc(s.x, y, s.r, 0, Math.PI * 2);
					ctx.fill();
					if (s.r > 1.4) {
						// a soft glow around the brightest stars
						ctx.globalAlpha = s.a * twinkle * 0.18;
						ctx.beginPath();
						ctx.arc(s.x, y, s.r * 3.2, 0, Math.PI * 2);
						ctx.fill();
					}
				}
			});
			if (shooter) {
				const { x, y, vx, vy, life } = shooter;
				const g = ctx.createLinearGradient(x, y, x - vx * 18, y - vy * 18);
				g.addColorStop(0, `rgba(235,240,250,${0.55 * life})`);
				g.addColorStop(1, 'rgba(235,240,250,0)');
				ctx.globalAlpha = 1;
				ctx.strokeStyle = g;
				ctx.lineWidth = 1.1;
				ctx.beginPath();
				ctx.moveTo(x, y);
				ctx.lineTo(x - vx * 18, y - vy * 18);
				ctx.stroke();
			}
			ctx.globalAlpha = 1;
		}

		function frame(t: number) {
			raf = 0;
			if (!isDark()) return;
			const dt = Math.min(50, t - (last || t));
			last = t;
			if (!shooter && t > nextShooter) {
				const fromLeft = Math.random() < 0.5;
				shooter = {
					x: fromLeft ? Math.random() * w * 0.5 : w * (0.5 + Math.random() * 0.5),
					y: Math.random() * h * 0.4,
					vx: (fromLeft ? 1 : -1) * (0.9 + Math.random() * 0.5),
					vy: 0.35 + Math.random() * 0.25,
					life: 1,
				};
			}
			if (shooter) {
				shooter.x += shooter.vx * dt;
				shooter.y += shooter.vy * dt;
				shooter.life -= dt / 900;
				if (shooter.life <= 0) {
					shooter = null;
					nextShooter = t + 25000 + Math.random() * 30000;
				}
			}
			draw(t);
			schedule();
		}
		const schedule = () => {
			if (!raf && !document.hidden && !reduce.matches && isDark()) raf = requestAnimationFrame(frame);
		};
		const redrawStatic = () => isDark() && draw(performance.now());

		seed();
		redrawStatic();
		schedule();
		let resizeTimer: number | undefined;
		addEventListener('resize', () => {
			clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(() => {
				seed();
				redrawStatic();
			}, 150);
		});
		// Parallax still follows scrolling when motion is reduced (one redraw per scroll, no animation).
		addEventListener('scroll', () => reduce.matches && requestAnimationFrame(redrawStatic), { passive: true });
		document.addEventListener('visibilitychange', schedule);
		reduce.addEventListener('change', () => (reduce.matches ? redrawStatic() : schedule()));
		new MutationObserver(() => {
			if (isDark()) {
				redrawStatic();
				schedule();
			}
		}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
	}
</script>
